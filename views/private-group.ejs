<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= group.name %> - Focus tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/icon.svg" type="image/svg+xml">
  <style>
    :root {
      --group-bg: #0b1020;
      --group-surface: #111827;
      --group-panel: rgba(21, 28, 39, 0.92);
      --group-panel-alt: rgba(16, 23, 34, 0.88);
      --group-card: rgba(19, 27, 38, 0.96);
      --group-soft: rgba(148, 163, 184, 0.1);
      --group-line: rgba(148, 163, 184, 0.18);
      --group-text: #edf3ff;
      --group-muted: #a0aec0;
      --group-teal: #59e0d5;
      --group-cyan: #7dd3fc;
      --group-violet: #8b5cf6;
      --group-green: #34d399;
      --group-yellow: #fbbf24;
      --group-rose: #f87171;
      --group-shadow: 0 18px 40px rgba(15, 23, 42, 0.35);
    }

    .group-detail-head { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; margin:34px 0 26px; }
    .group-detail-head h1 { margin:6px 0 6px; font-size:clamp(2rem, 2.8vw, 2.5rem); color:var(--group-text); }
    .group-detail-head p { color:var(--group-muted); margin:0; }
    .group-detail-actions { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .group-code-large { padding:11px 14px; border:1px dashed rgba(139,92,246,.65); border-radius:10px; color:#ddd6fe; background:rgba(139,92,246,.1); font-family:monospace; letter-spacing:2px; box-shadow:inset 0 0 0 1px rgba(139,92,246,.12); }
    .group-back { color:var(--group-teal); text-decoration:none; font-weight:700; }
    .group-back:hover { color:#bafef7; }
    .group-leave { border:1px solid rgba(248,113,113,.45); border-radius:10px; padding:10px 12px; background:transparent; color:#fecaca; cursor:pointer; transition:all .2s ease; }
    .group-leave:hover { background:rgba(127,29,29,.22); transform:translateY(-1px); }
    .group-delete { border:0; border-radius:10px; padding:10px 12px; background:linear-gradient(135deg, #ef4444, #dc2626); color:#fff; font-weight:700; cursor:pointer; box-shadow:0 10px 18px rgba(239,68,68,.18); transition:all .2s ease; }
    .group-delete:hover { transform:translateY(-1px); filter:brightness(1.05); }
    .group-table-wrap { overflow-x:auto; border:1px solid var(--group-line); border-radius:18px; background:linear-gradient(180deg, rgba(17,24,39,.97), rgba(15,20,29,.96)); box-shadow:var(--group-shadow); }
    .group-table { width:100%; min-width:760px; border-collapse:collapse; }
    .group-table th, .group-table td { padding:15px 17px; border-bottom:1px solid rgba(148,163,184,.08); text-align:left; }
    .group-table th { color:#a5b4c9; font-size:.72rem; letter-spacing:.08em; text-transform:uppercase; background:rgba(148,163,184,.03); }
    .group-table tr:last-child td { border-bottom:0; }
    .group-table tbody tr { transition:background .2s ease; }
    .group-table tbody tr:hover { background:rgba(148,163,184,.04); }
    .group-rank { color:#f9d56d; font-weight:800; width:65px; }
    .group-member { display:flex; align-items:center; gap:10px; }
    .group-member-avatar { width:34px; height:34px; display:grid; place-items:center; border-radius:50%; background:linear-gradient(135deg, #34d399, #6366f1); color:#fff; font-weight:800; box-shadow:0 10px 18px rgba(99,102,241,.18); }
    .group-member small { display:block; color:#8aa0bf; font-size:.75rem; }
    .group-stat { color:var(--group-teal); font-variant-numeric:tabular-nums; font-weight:700; }
    .group-manage { text-align:right !important; }
    .group-remove { border:1px solid rgba(248,113,113,.38); border-radius:8px; padding:7px 9px; background:rgba(248,113,113,.04); color:#fecaca; cursor:pointer; font-size:.78rem; transition:all .2s ease; }
    .group-remove:hover { background:rgba(127,29,29,.2); transform:translateY(-1px); }
    .group-period-tabs { display:flex; gap:8px; flex-wrap:wrap; margin:20px 0 14px; }
    .group-period-tab { border:1px solid rgba(148,163,184,.2); border-radius:10px; padding:9px 14px; background:rgba(15,23,42,.9); color:#e2e8f0; cursor:pointer; font-weight:600; transition:all .2s ease; }
    .group-period-tab.active { border-color:rgba(89,224,213,.8); background:linear-gradient(135deg, rgba(89,224,213,.22), rgba(139,92,246,.18)); color:#dffefc; box-shadow:0 8px 18px rgba(89,224,213,.12); font-weight:800; }
    .group-task-box { margin:18px 0 24px; padding:22px 20px; border:1px solid rgba(148,163,184,.12); border-radius:18px; background:linear-gradient(135deg, rgba(89,224,213,.08), rgba(99,102,241,.08), rgba(15,23,42,.6)); box-shadow:var(--group-shadow); }
    .group-task-box h2 { margin:0 0 14px; font-size:1.2rem; color:var(--group-text); }
    .group-task-form { display:flex; gap:12px; }
    .group-task-form input { flex:1; min-width:0; border:1px solid rgba(148,163,184,.18); border-radius:12px; background:rgba(15,23,42,.7); color:#fff; padding:12px 14px; box-shadow:inset 0 1px 0 rgba(255,255,255,.02); }
    .group-task-form input:focus { outline:none; border-color:rgba(89,224,213,.7); box-shadow:0 0 0 3px rgba(89,224,213,.12); }
    .group-task-form button { border:0; border-radius:12px; padding:12px 18px; background:linear-gradient(135deg, var(--group-teal), var(--group-violet)); color:#07151b; font-weight:800; cursor:pointer; box-shadow:0 12px 22px rgba(89,224,213,.18); transition:all .2s ease; }
    .group-task-form button:hover { transform:translateY(-1px); }
    .group-task-list { display:flex; flex-direction:column; gap:12px; margin-top:18px; }
    .group-task-item { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 16px; border-radius:14px; border:1px solid rgba(148,163,184,.12); background:linear-gradient(180deg, rgba(17,24,39,.85), rgba(15,23,42,.72)); box-shadow:inset 0 1px 0 rgba(255,255,255,.02); transition:transform .12s ease, border-color .12s ease, background .12s ease, box-shadow .12s ease; }
    .group-task-item:hover { transform:translateY(-1px); border-color:rgba(89,224,213,.25); }
    .group-task-item.done { border-color:rgba(52,211,153,.52); background:linear-gradient(180deg, rgba(16,52,38,.75), rgba(12,20,27,.74)); }
    .group-task-copy { flex:1; min-width:0; }
    .group-task-copy h3 { margin:0 0 4px; font-size:1rem; color:var(--group-text); }
    .group-task-copy p { margin:0; color:#a9b9ce; font-size:.82rem; }
    .group-task-actions { display:flex; align-items:center; gap:10px; }
    .group-task-toggle { display:flex; align-items:center; gap:8px; font-weight:600; color:#e5edf7; }
    .group-task-toggle input { width:18px; height:18px; accent-color:var(--group-teal); }
    .group-task-delete { border:1px solid rgba(248,113,113,.35); border-radius:8px; padding:7px 10px; background:transparent; color:#fda4af; cursor:pointer; transition:all .2s ease; }
    .group-task-delete:hover { background:rgba(127,29,29,.22); }
    .group-task-empty { color:#9ca9bb; padding:12px 0; }
    .group-note { margin:16px 0; color:#a0aec0; font-size:.85rem; }
    .group-error { margin-bottom:20px; padding:12px 14px; border:1px solid rgba(248,113,113,.35); border-radius:9px; color:#fca5a5; background:rgba(127,29,29,.2); }
    .group-analysis { margin:30px 0 26px; padding:20px; border:1px solid rgba(148,163,184,.14); border-radius:20px; background:linear-gradient(180deg, rgba(17,24,39,.88), rgba(15,20,29,.96)); box-shadow:var(--group-shadow); }
    .group-analysis-header { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:18px; }
    .group-analysis-header h2 { margin:0; font-size:1.04rem; letter-spacing:.08em; text-transform:uppercase; color:#dbe7ff; }
    .group-analysis-tabs { display:flex; gap:8px; flex-wrap:wrap; }
    .group-analysis-tab { border:1px solid rgba(148,163,184,.18); background:rgba(15,23,42,.7); color:#e5eaf0; border-radius:10px; padding:9px 14px; font-weight:700; cursor:pointer; }
    .group-analysis-tab.active { background:linear-gradient(135deg, rgba(89,224,213,.2), rgba(139,92,246,.18)); border-color:rgba(89,224,213,.7); color:#d9fffb; }
    .group-overview-grid { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:14px; margin-bottom:18px; }
    .group-overview-card { padding:18px 18px 16px; border:1px solid var(--group-line); border-radius:16px; background:linear-gradient(180deg, rgba(17,24,39,.9), rgba(12,18,28,.85)); box-shadow:inset 0 1px 0 rgba(255,255,255,.02); transition:all .2s ease; }
    .group-overview-card:hover { transform:translateY(-2px); border-color:rgba(89,224,213,.22); }
    .group-overview-card .label { color:#9fb0c8; font-size:.68rem; letter-spacing:.08em; text-transform:uppercase; margin-bottom:10px; }
    .group-overview-card .value { font-size:1.6rem; font-weight:800; letter-spacing:-.04em; color:var(--group-text); }
    .group-analysis-grid { display:grid; grid-template-columns:1.25fr 1fr; gap:18px; }
    .group-panel { border:1px solid var(--group-line); border-radius:18px; background:linear-gradient(180deg, rgba(18,24,35,.92), rgba(12,18,27,.9)); padding:16px; box-shadow:inset 0 1px 0 rgba(255,255,255,.02); }
    .group-panel h3 { margin:0 0 12px; font-size:.75rem; letter-spacing:.12em; text-transform:uppercase; color:#a4b7d0; }
    .group-ranking-list, .group-task-progress-list, .group-member-progress-list { display:flex; flex-direction:column; gap:12px; }
    .group-ranking-item, .group-task-progress-item, .group-member-progress-item { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:10px; }
    .group-ranking-item { grid-template-columns:28px 32px 1fr auto; }
    .group-rank-badge { font-weight:800; color:var(--group-yellow); }
    .group-row-avatar { width:30px; height:30px; border-radius:50%; display:grid; place-items:center; background:linear-gradient(135deg, #46d8c8, #7c6cff); color:#fff; font-size:.8rem; font-weight:800; box-shadow:0 8px 18px rgba(124,108,255,.2); }
    .group-rank-meta { display:flex; align-items:center; gap:8px; min-width:0; }
    .group-rank-name { font-weight:700; color:#edf3ff; }
    .group-rank-username { color:#93a5be; font-size:.75rem; }
    .group-rank-time { color:#dffef9; font-weight:700; font-variant-numeric:tabular-nums; }
    .group-progress-track { width:100%; height:10px; background:rgba(148,163,184,.12); border:1px solid rgba(148,163,184,.06); border-radius:999px; overflow:hidden; margin-top:6px; }
    .group-progress-fill { display:block; height:100%; border-radius:999px; background:linear-gradient(90deg, #44d6c7 0%, #7c6cff 100%); box-shadow:0 0 20px rgba(99,102,241,.24); }
    .group-progress-inline { display:flex; align-items:center; gap:8px; }
    .group-progress-inline .group-progress-track { flex:1; margin-top:0; }
    .group-progress-info { display:flex; justify-content:space-between; gap:12px; font-size:.8rem; color:#d4d4d8; }
    .group-task-list-compact, .group-member-grid { display:flex; flex-direction:column; gap:10px; }
    .group-task-row { display:grid; grid-template-columns:1fr auto; gap:12px; align-items:center; }
    .group-task-row .group-task-main { display:flex; flex-direction:column; gap:6px; }
    .group-task-row strong { color:#edf3ff; font-size:.92rem; }
    .group-task-row .meta { color:#9ca9bb; font-size:.74rem; }
    .group-task-status { color:#d1fae5; font-weight:700; }
    .group-task-row .group-progress-fill.complete { background:linear-gradient(90deg, #34d399, #2dd4bf); }
    .group-task-row .group-progress-fill.partial { background:linear-gradient(90deg, #a78bfa, #60a5fa); }
    .group-task-row .group-progress-fill.incomplete { background:linear-gradient(90deg, rgba(148,163,184,.28), rgba(148,163,184,.12)); }
    .group-bottom-grid { display:grid; grid-template-columns:1.15fr 0.85fr; gap:18px; margin-top:18px; }
    .group-member-progress-table { width:100%; border-collapse:collapse; }
    .group-member-progress-table th, .group-member-progress-table td { padding:9px 8px; border-bottom:1px solid rgba(148,163,184,.08); text-align:left; }
    .group-member-progress-table th { color:#a3b2c9; font-size:.7rem; letter-spacing:.08em; text-transform:uppercase; }
    .group-member-progress-table tr:last-child td { border-bottom:0; }
    .group-member-mini { display:flex; align-items:center; gap:8px; }
    .group-member-mini .group-row-avatar { width:24px; height:24px; font-size:.7rem; }
    .group-detail-card { display:flex; flex-direction:column; gap:12px; }
    .group-detail-header { display:flex; align-items:center; gap:12px; }
    .group-detail-info { display:flex; flex-direction:column; }
    .group-detail-metrics { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:10px; }
    .group-detail-metric { padding:10px 12px; border:1px solid rgba(148,163,184,.12); border-radius:12px; background:linear-gradient(180deg, rgba(17,24,39,.85), rgba(12,18,27,.8)); }
    .group-detail-metric small { display:block; color:#9cafc8; margin-bottom:5px; }
    .group-detail-metric strong { color:#edf3ff; font-size:1.05rem; }
    .group-detail-activity { display:flex; flex-direction:column; gap:8px; }
    .group-detail-activity span { padding:8px 10px; background:rgba(148,163,184,.04); border:1px solid rgba(148,163,184,.08); border-radius:10px; color:#dbe7ff; }
    .group-member-clickable { cursor:pointer; }
    @media (max-width:980px) { .group-overview-grid { grid-template-columns:repeat(2, minmax(0,1fr)); } .group-analysis-grid, .group-bottom-grid { grid-template-columns:1fr; } }
    @media (max-width:700px) { .group-detail-head { flex-direction:column; } .group-detail-actions { width:100%; } .group-task-form { flex-direction:column; } .group-overview-grid { grid-template-columns:1fr; } .group-analysis-header { flex-direction:column; align-items:flex-start; } }
  </style>
</head>
<body>
  <%- include('partials/loader') %>
  <%- include('partials/app-header') %>
  <main class="container">
    <section class="group-detail-head">
      <div>
        <a class="group-back" href="/private-groups">&larr; All groups</a>
        <h1><%= group.name %></h1>
        <p><%= stats.length %> / 10 members &middot; Share this code to invite people</p>
      </div>
      <div class="group-detail-actions">
        <span class="group-code-large"><%= group.code %></span>
        <% if (isOwner) { %>
          <form action="/private-groups/<%= group._id %>/delete" method="POST" onsubmit="return confirm('⚠️ Delete this private group permanently? All membership data will be removed from the database.');">
            <button class="group-delete" type="submit">Delete group</button>
          </form>
        <% } else { %>
          <form action="/private-groups/<%= group._id %>/leave" method="POST">
            <button class="group-leave" type="submit">Leave group</button>
          </form>
        <% } %>
      </div>
    </section>

    <% if (typeof queryError !== 'undefined' && queryError) { %><div class="group-error"><%= queryError %></div><% } %>

    <section class="group-task-box">
      <h2>Today's Group To-Do</h2>
      <form class="group-task-form" action="/private-groups/<%= group._id %>/tasks" method="POST">
        <input type="text" name="title" maxlength="180" placeholder="Add a task for all members" required>
        <button type="submit">Add task</button>
      </form>

      <% if (groupTasks && groupTasks.length) { %>
        <div class="group-task-list">
          <% groupTasks.forEach(task => { %>
            <div class="group-task-item <%= task.isDoneByMe ? 'done' : '' %>" data-task-id="<%= task._id %>">
              <div class="group-task-copy">
                <h3><%= task.title %></h3>
                <p><%= task.completedCount %> of <%= task.assignedCount %> members completed</p>
              </div>
              <div class="group-task-actions">
                <label class="group-task-toggle">
                  <input type="checkbox" data-toggle-task="<%= task._id %>" <%= task.isDoneByMe ? 'checked' : '' %>>
                  <span>Done</span>
                </label>
                <% if (String(task.createdBy) === String(user._id) || isOwner) { %>
                  <button class="group-task-delete" type="button" data-delete-task="<%= task._id %>">Delete</button>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="group-task-empty">No task scheduled for today yet.</div>
      <% } %>
    </section>

    <section class="group-analysis">
      <div class="group-analysis-header">
        <h2>Analysis</h2>
        <div class="group-analysis-tabs" role="tablist" aria-label="Group analysis period">
          <button type="button" class="group-analysis-tab active" data-analysis-period="daily">Daily</button>
        </div>
      </div>

      <div class="group-overview-grid">
        <div class="group-overview-card">
          <div class="label">Total Group Focus</div>
          <div class="value" id="overview-total-focus"><%= analysis.daily.overview.totalFocusLabel %></div>
        </div>
        <div class="group-overview-card">
          <div class="label">Avg. Focus / Member</div>
          <div class="value" id="overview-average-focus"><%= analysis.daily.overview.averageFocusLabel %></div>
        </div>
        <div class="group-overview-card">
          <div class="label">Tasks Completed</div>
          <div class="value" id="overview-task-done"><%= analysis.daily.overview.tasksDoneText %></div>
        </div>
        <div class="group-overview-card">
          <div class="label">Completion Rate</div>
          <div class="value" id="overview-completion-rate"><%= analysis.daily.overview.completionLabel %></div>
        </div>
      </div>

      <div class="group-analysis-grid">
        <div class="group-panel">
          <h3>Focus Ranking</h3>
          <div class="group-ranking-list" id="group-ranking-list">
            <% (analysis.daily.ranking || []).slice(0, 5).forEach((member, index) => { %>
              <div class="group-ranking-item group-member-clickable" data-member-id="<%= member.userId %>">
                <div class="group-rank-badge"><%= index + 1 %></div>
                <div class="group-row-avatar"><%= member.initials %></div>
                <div>
                  <div class="group-rank-meta">
                    <span class="group-rank-name"><%= member.name %></span>
                    <span class="group-rank-username">@<%= member.username %></span>
                  </div>
                  <div class="group-progress-track"><span class="group-progress-fill" style="width:<%= member.progress %>%"></span></div>
                </div>
                <div class="group-rank-time"><%= member.focusLabel %></div>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="group-panel">
          <h3>Task Progress</h3>
          <div class="group-task-progress-list" id="group-task-progress-list">
            <% (analysis.daily.taskProgress || []).slice(0, 5).forEach(member => { %>
              <div class="group-task-progress-item">
                <div class="group-rank-name"><%= member.name %></div>
                <div class="group-progress-inline">
                  <span class="group-rank-time"><%= member.completedCount %>/<%= member.totalTasks %></span>
                  <div class="group-progress-track"><span class="group-progress-fill" style="width:<%= member.progress %>%"></span></div>
                </div>
                <div class="group-rank-time"><%= member.rate %>%</div>
              </div>
            <% }) %>
          </div>
        </div>

      </div>

      <div class="group-bottom-grid">
        <div class="group-panel">
          <h3>Group Tasks</h3>
          <div class="group-task-list-compact" id="group-task-list-compact">
            <% (analysis.daily.groupTasks || []).slice(0, 6).forEach(task => { %>
              <div class="group-task-row">
                <div class="group-task-main">
                  <strong><%= task.title %></strong>
                  <div class="group-progress-track"><span class="group-progress-fill <%= task.percent >= 100 ? 'complete' : task.percent > 0 ? 'partial' : 'incomplete' %>" style="width:<%= task.percent %>%"></span></div>
                </div>
                <div class="group-task-status"><%= task.completedCount %>/<%= task.totalMembers %></div>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="group-panel">
          <h3>Member Detail</h3>
          <div class="group-detail-card" id="member-detail-card">
            <% const firstMember = (analysis.daily.ranking || [])[0]; %>
            <% if (firstMember) { %>
              <div class="group-detail-header">
                <div class="group-row-avatar"><%= firstMember.initials %></div>
                <div class="group-detail-info">
                  <strong><%= firstMember.name %></strong>
                  <span>@<%= firstMember.username %></span>
                </div>
              </div>
              <div class="group-detail-metrics">
                <div class="group-detail-metric"><small>Focus</small><strong><%= firstMember.focusLabel %></strong></div>
                <div class="group-detail-metric"><small>Tasks</small><strong><%= firstMember.completedTasks %>/<%= firstMember.totalTasks || 0 %></strong></div>
                <div class="group-detail-metric"><small>Completion</small><strong><%= firstMember.completionRate %>%</strong></div>
                <div class="group-detail-metric"><small>Pending</small><strong><%= firstMember.pendingTasks || 0 %></strong></div>
              </div>
              <div class="group-detail-activity">
                <span>Recent group-task activity: <%= firstMember.completedTasks %> task completions</span>
              </div>
            <% } %>
          </div>
        </div>
      </div>

    </section>

    <p class="group-note">Rankings are based on focus minutes from timer sessions and manual focus logs. Private members can participate here without appearing in public rankings.</p>
    <div class="group-table-wrap" aria-label="Private group focus leaderboard">
      <div class="group-period-tabs" role="tablist" aria-label="Group ranking period" style="padding:18px 18px 0;">
        <button type="button" class="group-period-tab active" data-period="today">Daily</button>
        <button type="button" class="group-period-tab" data-period="week">Weekly</button>
        <button type="button" class="group-period-tab" data-period="month">Monthly</button>
      </div>
      <table class="group-table">
        <thead>
          <tr><th>Rank</th><th>Member</th><th id="group-period-heading">Daily focus</th><% if (isOwner) { %><th class="group-manage">Manage</th><% } %></tr>
        </thead>
        <tbody id="group-member-progress-body">
          <% stats.forEach((member, index) => { %>
            <tr data-today="<%= member.todayMinutes %>" data-week="<%= member.weekMinutes %>" data-month="<%= member.monthMinutes %>">
              <td class="group-rank" data-rank>#<%= index + 1 %></td>
              <td>
                <div class="group-member">
                  <span class="group-member-avatar"><%= (member.name || '?').charAt(0).toUpperCase() %></span>
                  <span><strong><%= member.name %></strong><small>@<%= member.username || 'focususer' %></small></span>
                </div>
              </td>
              <td class="group-stat" data-period-value><%= formatMinutes(member.todayMinutes, user.timeUnit) %></td>
              <% if (isOwner) { %>
                <td class="group-manage">
                  <% if (String(member._id) !== String(group.ownerId)) { %>
                    <form action="/private-groups/<%= group._id %>/remove-member" method="POST" onsubmit="return confirm('⚠️ Remove this member from the group? They will lose access to this private leaderboard.');">
                      <input type="hidden" name="memberId" value="<%= member._id %>">
                      <button class="group-remove" type="submit">Remove</button>
                    </form>
                  <% } else { %>
                    <span style="color:#777; font-size:.78rem;">Owner</span>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </main>
  <script>
    const groupPeriodHeading = document.getElementById('group-period-heading');
    const groupPeriodTabs = document.querySelectorAll('[data-period]');
    const groupRows = [...document.querySelectorAll('tbody tr[data-today]')];
    const periodLabels = { today: 'Daily focus', week: 'Weekly focus', month: 'Monthly focus' };
    const analysisTabs = document.querySelectorAll('[data-analysis-period]');
    const taskForm = document.querySelector('.group-task-form');
    const currentUserId = '<%= String(user._id) %>';
    let currentAnalysisPeriod = 'daily';
    let state = {
      tasks: <%- JSON.stringify(groupTasks || []) %>,
      analysis: <%- JSON.stringify(analysis || {}) %>
    };

    function formatGroupTime(minutes) {
      const value = <%= user.timeUnit === 'hours' ? 'Math.round((minutes / 60) * 10) / 10' : 'Math.round(minutes)' %>;
      return `${value % 1 === 0 ? value.toFixed(0) : value.toFixed(1)}<%= user.timeUnit === 'hours' ? 'h' : 'm' %>`;
    }

    function renderGroupRanking(period) {
      groupRows.sort((first, second) => Number(second.dataset[period]) - Number(first.dataset[period]));
      groupRows.forEach((row, index) => {
        row.querySelector('[data-rank]').textContent = `#${index + 1}`;
        row.querySelector('[data-period-value]').textContent = formatGroupTime(Number(row.dataset[period]));
        row.parentElement.appendChild(row);
      });
      groupPeriodHeading.textContent = periodLabels[period];
      groupPeriodTabs.forEach(tab => tab.classList.toggle('active', tab.dataset.period === period));
    }

    function renderTaskList() {
      const list = document.querySelector('.group-task-list');
      if (!list) return;

      if (!state.tasks.length) {
        list.innerHTML = '<div class="group-task-empty">No task scheduled for today yet.</div>';
        return;
      }

      list.innerHTML = state.tasks.map(task => {
        const isDone = Boolean(task.isDoneByMe);
        const canDelete = String(task.createdBy) === currentUserId || <%= Boolean(isOwner) %>;
        return `
          <div class="group-task-item ${isDone ? 'done' : ''}" data-task-id="${task._id}">
            <div class="group-task-copy">
              <h3>${task.title}</h3>
              <p>${task.completedCount} of ${task.assignedCount} members completed</p>
            </div>
            <div class="group-task-actions">
              <label class="group-task-toggle">
                <input type="checkbox" data-toggle-task="${task._id}" ${isDone ? 'checked' : ''}>
                <span>Done</span>
              </label>
              ${canDelete ? `<button class="group-task-delete" type="button" data-delete-task="${task._id}">Delete</button>` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    function renderMemberDetailCard(member) {
      const detailCard = document.getElementById('member-detail-card');
      if (!member) {
        detailCard.innerHTML = '<span class="group-task-empty">No member data available for this period.</span>';
        return;
      }

      const totalTasks = Number(member.totalTasks || member.totalTaskCount || 0);
      const completedTasks = Number(member.completedTasks || member.completedCount || 0);
      const pendingTasks = Number(member.pendingTasks || Math.max(totalTasks - completedTasks, 0));
      const completionRate = Number(member.completionRate || (totalTasks ? Math.round((completedTasks / totalTasks) * 100) : 0));

      detailCard.innerHTML = `
        <div class="group-detail-header">
          <div class="group-row-avatar">${member.initials || '?'}</div>
          <div class="group-detail-info">
            <strong>${member.name}</strong>
            <span>@${member.username || 'focususer'}</span>
          </div>
        </div>
        <div class="group-detail-metrics">
          <div class="group-detail-metric"><small>Focus</small><strong>${member.focusLabel || '0m'}</strong></div>
          <div class="group-detail-metric"><small>Tasks</small><strong>${completedTasks}/${totalTasks}</strong></div>
          <div class="group-detail-metric"><small>Completion</small><strong>${completionRate}%</strong></div>
          <div class="group-detail-metric"><small>Pending</small><strong>${pendingTasks}</strong></div>
        </div>
        <div class="group-detail-activity">
          <span>Recent group-task activity: ${completedTasks} task completions</span>
        </div>
      `;
    }

    function renderAnalysis(period) {
      currentAnalysisPeriod = period;
      const data = state.analysis[period] || state.analysis.daily || {};
      const overview = data.overview || {};
      document.getElementById('overview-total-focus').textContent = overview.totalFocusLabel || '0m';
      document.getElementById('overview-average-focus').textContent = overview.averageFocusLabel || '0m';
      document.getElementById('overview-task-done').textContent = overview.tasksDoneText || '0/0';
      document.getElementById('overview-completion-rate').textContent = overview.completionLabel || '0%';

      const rankingList = document.getElementById('group-ranking-list');
      rankingList.innerHTML = (data.ranking || []).slice(0, 5).map((member, index) => `
        <div class="group-ranking-item group-member-clickable" data-member-id="${member.userId}">
          <div class="group-rank-badge">${index + 1}</div>
          <div class="group-row-avatar">${member.initials || '?'}</div>
          <div>
            <div class="group-rank-meta">
              <span class="group-rank-name">${member.name}</span>
              <span class="group-rank-username">@${member.username || 'focususer'}</span>
            </div>
            <div class="group-progress-track"><span class="group-progress-fill" style="width:${member.progress || 0}%"></span></div>
          </div>
          <div class="group-rank-time">${member.focusLabel || '0m'}</div>
        </div>
      `).join('');

      const progressList = document.getElementById('group-task-progress-list');
      progressList.innerHTML = (data.taskProgress || []).slice(0, 5).map(member => `
        <div class="group-task-progress-item">
          <div class="group-rank-name">${member.name}</div>
          <div class="group-progress-inline">
            <span class="group-rank-time">${member.completedCount}/${member.totalTasks}</span>
            <div class="group-progress-track"><span class="group-progress-fill" style="width:${member.progress || 0}%"></span></div>
          </div>
          <div class="group-rank-time">${member.rate || 0}%</div>
        </div>
      `).join('');

      const taskList = document.getElementById('group-task-list-compact');
      taskList.innerHTML = (data.groupTasks || []).slice(0, 6).map(task => {
        let className = 'incomplete';
        if (task.percent >= 100) className = 'complete';
        else if (task.percent > 0) className = 'partial';
        return `
          <div class="group-task-row">
            <div class="group-task-main">
              <strong>${task.title}</strong>
              <div class="group-progress-track"><span class="group-progress-fill ${className}" style="width:${task.percent || 0}%"></span></div>
            </div>
            <div class="group-task-status">${task.completedCount}/${task.totalMembers}</div>
          </div>
        `;
      }).join('');

      renderMemberDetailCard((data.ranking || [])[0]);

      const memberBody = document.getElementById('group-member-progress-body');
      if (memberBody) {
        memberBody.innerHTML = (data.memberProgress || []).slice(0, 6).map(member => `
          <tr class="group-member-clickable" data-member-id="${member.userId}">
            <td>
              <div class="group-member-mini">
                <span class="group-row-avatar">${member.initials || '?'}</span>
                <span>${member.name}</span>
              </div>
            </td>
            <td>${member.focusLabel || '0m'}</td>
            <td>${member.tasksText || '0/0'}</td>
          </tr>
        `).join('');
      }

      document.querySelectorAll('.group-member-clickable').forEach(row => {
        row.addEventListener('click', () => {
          const memberId = row.dataset.memberId;
          const member = (data.ranking || []).find(item => String(item.userId) === String(memberId)) || (data.memberProgress || []).find(item => String(item.userId) === String(memberId));
          if (!member) return;
          renderMemberDetailCard(member);
        });
      });
    }

    function syncTaskBasedAnalysis() {
      const periodKey = currentAnalysisPeriod || 'daily';
      const baseData = state.analysis[periodKey] || state.analysis.daily || {};
      const activeTasks = (state.tasks || []).map(task => {
        const assignedIds = (task.assignedTo || []).map(id => String(id));
        const completedIds = (task.completedBy || []).map(id => String(id));
        const assignedCount = assignedIds.length || Math.max((baseData.ranking || []).length, 1);
        const completedCount = assignedIds.length
          ? assignedIds.filter(id => completedIds.includes(id)).length
          : 0;
        const percent = assignedCount ? Math.round((completedCount / assignedCount) * 100) : 0;
        return {
          _id: task._id,
          title: task.title,
          completedCount,
          totalMembers: assignedCount,
          percent,
          completedIds
        };
      });

      const ranking = (baseData.ranking || []).map(member => {
        const memberId = String(member.userId);
        const completedTasks = activeTasks.filter(task => (task.completedIds || []).includes(memberId)).length;
        const totalTasks = Math.max(activeTasks.length || 1, 1);
        const pendingTasks = Math.max(totalTasks - completedTasks, 0);
        const completionRate = totalTasks ? Math.round((completedTasks / totalTasks) * 100) : 0;
        return {
          ...member,
          completedTasks,
          pendingTasks,
          totalTasks,
          completionRate,
          totalTaskCount: totalTasks
        };
      });

      const totalCompletedTasks = ranking.reduce((sum, member) => sum + (member.completedTasks || 0), 0);
      const totalTaskSlots = Math.max(ranking.length * Math.max(activeTasks.length || 1, 1), 1);
      const completionRate = totalTaskSlots ? Math.round((totalCompletedTasks / totalTaskSlots) * 100) : 0;

      const refreshedRanking = ranking.map(member => ({
        ...member,
        totalTasks: Math.max(activeTasks.length || 1, 1),
        pendingTasks: Math.max(Math.max(activeTasks.length || 1, 1) - (member.completedTasks || 0), 0),
        completionRate: Math.max(activeTasks.length || 1, 1)
          ? Math.round(((member.completedTasks || 0) / Math.max(activeTasks.length || 1, 1)) * 100)
          : 0
      }));

      state.analysis[periodKey] = {
        ...baseData,
        ranking: refreshedRanking,
        overview: {
          ...(baseData.overview || {}),
          tasksDoneText: `${totalCompletedTasks}/${totalTaskSlots}`,
          tasksDoneCount: totalCompletedTasks,
          tasksTotal: totalTaskSlots,
          completionRate,
          completionLabel: `${completionRate}%`
        },
        groupTasks: activeTasks,
        taskProgress: refreshedRanking.map(member => {
          const totalTasks = Math.max(activeTasks.length || 1, 1);
          const completedCount = member.completedTasks || 0;
          const rate = totalTasks ? Math.round((completedCount / totalTasks) * 100) : 0;
          return {
            ...member,
            completedCount,
            totalTasks,
            rate,
            progress: Math.max(10, rate),
            completedTasks: completedCount
          };
        }).sort((a, b) => b.rate - a.rate || b.completedCount - a.completedCount),
        memberProgress: refreshedRanking.map(member => ({
          ...member,
          totalTasks: Math.max(activeTasks.length || 1, 1),
          tasksText: `${member.completedTasks}/${Math.max(activeTasks.length || 1, 1)}`,
          focusLabel: member.focusLabel || '0m',
          initials: member.initials || '?'
        }))
      };
    }

    function applyServerState(payload) {
      if (!payload) return;
      if (Array.isArray(payload.groupTasks)) {
        state.tasks = payload.groupTasks;
      }
      if (payload.analysis && payload.analysis.daily) {
        state.analysis = payload.analysis;
      }
      syncTaskBasedAnalysis();
      renderTaskList();
      renderAnalysis(currentAnalysisPeriod);
    }

    analysisTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        analysisTabs.forEach(item => item.classList.toggle('active', item === tab));
        renderAnalysis(tab.dataset.analysisPeriod);
      });
    });

    groupPeriodTabs.forEach(tab => tab.addEventListener('click', () => renderGroupRanking(tab.dataset.period)));
    renderGroupRanking('today');
    renderTaskList();
    renderAnalysis('daily');

    if (taskForm) {
      taskForm.addEventListener('submit', async function (event) {
        event.preventDefault();
        const input = this.querySelector('input[name="title"]');
        const title = (input ? input.value : '').trim();
        if (!title) return;

        const optimisticTask = {
          _id: `temp-${Date.now()}`,
          title,
          createdBy: currentUserId,
          assignedTo: [],
          completedBy: [],
          assignedCount: Math.max((state.tasks[0] && state.tasks[0].assignedCount) || 1, 1),
          completedCount: 0,
          isDoneByMe: false
        };

        const previousTasks = [...state.tasks];
        state.tasks = [optimisticTask, ...state.tasks];
        syncTaskBasedAnalysis();
        renderTaskList();
        renderAnalysis(currentAnalysisPeriod);

        if (input) input.value = '';

        try {
          const response = await fetch(this.action, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ title }).toString()
          });

          const payload = await response.json().catch(() => null);
          if (!response.ok || !payload || !payload.success) {
            state.tasks = previousTasks;
            syncTaskBasedAnalysis();
            renderTaskList();
            renderAnalysis(currentAnalysisPeriod);
            if (input) input.focus();
            return;
          }

          applyServerState(payload);
        } catch (error) {
          state.tasks = previousTasks;
          syncTaskBasedAnalysis();
          renderTaskList();
          renderAnalysis(currentAnalysisPeriod);
          console.error('Task add failed', error);
        }
      });
    }

    document.addEventListener('change', async function (event) {
      const checkbox = event.target.closest('[data-toggle-task]');
      if (!checkbox) return;

      const taskId = checkbox.dataset.toggleTask;
      const previousState = checkbox.checked;
      const previousTasks = [...state.tasks];

      state.tasks = state.tasks.map(task => {
        if (String(task._id) !== String(taskId)) return task;
        const nextDone = !previousState;
        const updatedCompletedCount = Math.max(0, (task.completedCount || 0) + (nextDone ? 1 : -1));
        return {
          ...task,
          isDoneByMe: nextDone,
          completedCount: updatedCompletedCount,
          completedBy: nextDone ? [...(task.completedBy || []), currentUserId] : (task.completedBy || []).filter(id => String(id) !== String(currentUserId))
        };
      });
      syncTaskBasedAnalysis();
      renderTaskList();
      renderAnalysis(currentAnalysisPeriod);

      try {
        const response = await fetch(`/private-groups/<%= group._id %>/tasks/${taskId}/toggle`, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        const payload = await response.json().catch(() => null);
        if (!response.ok || !payload || !payload.success) {
          state.tasks = previousTasks;
          syncTaskBasedAnalysis();
          renderTaskList();
          renderAnalysis(currentAnalysisPeriod);
          checkbox.checked = !previousState;
          return;
        }

        checkbox.checked = Boolean(payload.isDone);
        applyServerState(payload);
      } catch (error) {
        state.tasks = previousTasks;
        syncTaskBasedAnalysis();
        renderTaskList();
        renderAnalysis(currentAnalysisPeriod);
        checkbox.checked = previousState;
      }
    });

    document.addEventListener('click', async function (event) {
      const deleteButton = event.target.closest('[data-delete-task]');
      if (!deleteButton) return;

      const taskId = deleteButton.dataset.deleteTask;
      const confirmed = window.confirm('Delete this scheduled task?');
      if (!confirmed) return;

      const previousTasks = [...state.tasks];
      state.tasks = state.tasks.filter(task => String(task._id) !== String(taskId));
      syncTaskBasedAnalysis();
      renderTaskList();
      renderAnalysis(currentAnalysisPeriod);

      try {
        const response = await fetch(`/private-groups/<%= group._id %>/tasks/${taskId}/delete`, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        const payload = await response.json().catch(() => null);
        if (!response.ok || !payload || !payload.success) {
          state.tasks = previousTasks;
          syncTaskBasedAnalysis();
          renderTaskList();
          renderAnalysis(currentAnalysisPeriod);
          return;
        }

        applyServerState(payload);
      } catch (error) {
        state.tasks = previousTasks;
        syncTaskBasedAnalysis();
        renderTaskList();
        renderAnalysis(currentAnalysisPeriod);
        console.error('Task delete failed', error);
      }
    });
  </script>
</body>
</html>
