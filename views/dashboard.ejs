<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Focus tracker</title>
  
  <link rel="preload" href="/css/style.css" as="style">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="icon" href="/images/icon.svg" type="image/svg+xml">
  
  <style>
    :root {
      --bg-dark: #050505;
      --glass-surface: rgba(20, 20, 20, 0.6);
      --glass-border: 1px solid rgba(255, 255, 255, 0.06);
      --neon-gold: #FFD700;
      --neon-blue: #00f2ea;
      --neon-red: #ff0055;
      --neon-purple: #bc13fe;
      --card-radius: 20px;
      --transition-fast: all 0.2s ease;
      --transition-smooth: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    }
    

    body {
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 0% 0%, rgba(255, 215, 0, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 100% 100%, rgba(0, 242, 234, 0.05) 0%, transparent 40%);
      background-attachment: fixed;
      font-family: 'Segoe UI', sans-serif;
      min-height: 100vh;
      color: #fff;
    }

    .container {
      width: 90%;
      max-width: none;
      margin: 0 auto;
      padding: 0 8px 80px 8px;
    }

    .animate-up { animation: fadeSlideUp 0.6s ease-out forwards; opacity: 0; transform: translateY(20px);
    }
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s;
    }
    .delay-3 { animation-delay: 0.3s; }
    
    @keyframes fadeSlideUp { to { opacity: 1;
      transform: translateY(0); } }

    /* --- 1. Header & Hero --- */
    .dashboard-hero {
      display: flex;
      justify-content: space-between; align-items: center;
      margin-bottom: 15px; flex-wrap: wrap; gap: 20px;
    }
    .hero-text h1 {
      font-size: 2.2rem; margin-bottom: 1px; font-weight: 800;
      color: #fff;
      letter-spacing: -0.5px;
    }
    .hero-text p { color: #999; font-size: 1rem;
    }

    .btn-log-session {
      background: #fff; color: #000; border: none;
      padding: 14px 30px;
      border-radius: 50px;
      font-weight: 700; font-size: 0.95rem;
      cursor: pointer; display: flex; align-items: center; gap: 10px;
      box-shadow: 0 0 25px rgba(255, 255, 255, 0.15);
      transition: var(--transition-fast);
    }
    .btn-log-session:hover { transform: translateY(-2px);
      box-shadow: 0 0 35px rgba(255, 255, 255, 0.3); }

    /* --- 2. Level & XP Card (Z-Index Fix) --- */
    .level-section {
      background: var(--glass-surface);
      border: var(--glass-border);
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      border-radius: var(--card-radius); padding: 30px;
      margin-bottom: 30px; 
      display: flex; align-items: center; gap: 30px;
      /* High Z-Index for Tooltip */
      position: relative; 
      z-index: 100; 
      overflow: visible;
    }

    .level-ring {
      position: relative; width: 85px; height: 85px; border-radius: 50%;
      background: conic-gradient(var(--neon-gold) 0deg, rgba(255,255,255,0.05) 0deg);
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 0 30px rgba(255, 215, 0, 0.1);
      flex-shrink: 0;
    }
    .level-ring::after {
      content: ''; position: absolute; width: 75px;
      height: 75px;
      background: var(--bg-dark); border-radius: 50%;
    }
    .level-text { position: relative; z-index: 2; text-align: center; line-height: 1;
    }
    .lvl-num { font-size: 1.8rem; font-weight: 800; color: #fff; display: block;
    }
    .lvl-lbl { font-size: 0.7rem; color: var(--neon-gold); font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
    }

    .xp-details { flex-grow: 1; }
    .xp-header { display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 12px; }
    
    .xp-pill {
      background: rgba(255, 215, 0, 0.08);
      border: 1px solid rgba(255, 215, 0, 0.2);
      padding: 6px 16px; border-radius: 12px;
      color: var(--neon-gold); font-weight: 700; font-size: 0.9rem;
      display: inline-flex;
      align-items: center; gap: 8px;
      cursor: pointer; transition: var(--transition-fast);
    }
    .xp-pill:hover { background: rgba(255, 215, 0, 0.15);
      box-shadow: 0 0 15px rgba(255, 215, 0, 0.2); }

    .info-trigger {
      width: 28px;
      height: 28px; border-radius: 50%;
      background: rgba(255,255,255,0.1); color: #888;
      display: flex; align-items: center; justify-content: center;
      cursor: help; position: relative; transition: 0.2s;
    }
    .info-trigger:hover { background: rgba(255,255,255,0.2); color: #fff;
    }
    
    .tooltip-box {
      position: absolute; top: 40px;
      right: 0; width: 260px;
      background: #151515; border: 1px solid rgba(255,255,255,0.2);
      padding: 15px; border-radius: 12px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.8);
      opacity: 0; visibility: hidden; transform: translateY(-10px);
      transition: all 0.2s ease; pointer-events: none;
      z-index: 9999;
    }
    .info-trigger:hover .tooltip-box { opacity: 1; visibility: visible; transform: translateY(0);
    }

    .xp-bar-bg { height: 8px; background: rgba(255,255,255,0.05); border-radius: 10px; overflow: hidden; margin-bottom: 8px;
    }
    .xp-bar-fill { height: 100%; background: linear-gradient(90deg, #FFD700, #ff9100); width: 0%;
      box-shadow: 0 0 15px rgba(255, 215, 0, 0.4); transition: width 1s ease-out;
    }

    /* --- 3. Main Grid --- */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr; gap: 25px; margin-bottom: 30px;
      position: relative; z-index: 1;
    }

    .dashboard-workspace { display:grid; grid-template-columns:minmax(0, 55%) minmax(0, 45%); gap:22px; align-items:start; margin-bottom:30px; }
    .dashboard-side { min-width:0; }
    .planner-panel { min-height:620px; padding:30px; border:1px solid rgba(0,242,234,.16); border-radius:28px; background:linear-gradient(135deg,rgba(0,242,234,.08),rgba(20,20,20,.7)); box-shadow:0 24px 70px rgba(0,0,0,.28); }
    .planner-heading, .planner-list-heading, .planner-note-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; }
    .planner-heading { align-items:flex-start; }
    .planner-heading h2 { margin:0; font-size:1.42rem; letter-spacing:-.02em; }
    .planner-heading h2 span { color:#a7a8ff; }
    .planner-heading p { margin:3px 0 0; color:#858590; font-size:.78rem; }
    .planner-icon-button, .planner-action { border:1px solid rgba(255,255,255,.12); border-radius:8px; background:#161616; color:#fff; padding:8px 10px; cursor:pointer; font:inherit; }
    .planner-action { background:rgba(0,242,234,.12); border-color:rgba(0,242,234,.3); color:#8ffffb; font-size:.78rem; font-weight:800; }
    .planner-date-controls { display:flex; align-items:center; gap:6px; }
    .planner-date-controls button { width:32px; height:32px; border:1px solid rgba(255,255,255,.12); border-radius:50%; background:#19191d; color:#fff; cursor:pointer; }
    .planner-date-label { color:#aaa; font-size:.78rem; font-weight:700; }
    .planner-date-picker { position:relative; width:34px; height:34px; overflow:hidden; }
    .planner-date-picker button { position:absolute; inset:0; z-index:1; display:grid; place-items:center; border:1px solid rgba(167,168,255,.4); border-radius:9px; background:rgba(167,168,255,.12); color:#d7d8ff; cursor:pointer; }
    .planner-date-picker button:hover { background:rgba(167,168,255,.22); color:#fff; }
    .planner-date-picker svg { width:18px; height:18px; stroke-width:2.2; }
    .planner-date-picker input { position:absolute; inset:0; width:100%; height:100%; opacity:0; cursor:pointer; }
    .planner-list-heading { margin:14px 0 6px; }
    .planner-list-heading h3, .planner-note-heading h3 { margin:0; font-size:.9rem; }
    .planner-task-list { min-height:150px; margin-top:0; padding:0; }
    .planner-empty { padding:28px 12px; color:#666; text-align:center; font-size:.82rem; border:1px dashed rgba(255,255,255,.1); border-radius:10px; }
    .planner-task { display:flex; align-items:center; gap:10px; margin:6px 0; padding:10px 14px; border:1px solid rgba(255,255,255,.1); border-radius:14px; background:linear-gradient(110deg,#1a1b1e,#111214); cursor:grab; }
    .planner-task:active { cursor:grabbing; }
    .planner-task.is-dragging { opacity:.35; }
    .planner-drop-line { height:3px; margin:3px 12px; border-radius:3px; background:#a7a8ff; box-shadow:0 0 12px rgba(167,168,255,.8); }
    .planner-task input { width:19px; height:19px; accent-color:#aab0b5; flex:0 0 auto; }
    .planner-task span { min-width:0; flex:1; color:#eee; font-size:.98rem; overflow-wrap:anywhere; }
    .planner-task.completed { border-color:rgba(255,255,255,.07); background:linear-gradient(110deg,#141517,#0d0e10); }
    .planner-task.completed span { color:#777b80; text-decoration:line-through; }
    .planner-delete, .planner-move { width:32px; height:32px; display:grid; place-items:center; flex:0 0 32px; border:0; background:transparent; color:#666; cursor:pointer; font-size:1.05rem; opacity:0; transition:opacity .15s ease,color .15s ease,transform .15s ease; }
    .planner-task:hover .planner-delete, .planner-task:hover .planner-move, .planner-task:focus-within .planner-delete, .planner-task:focus-within .planner-move { opacity:1; }
    .planner-delete:hover { color:#ff6b81; }
    .planner-move:hover { color:#a7a8ff; transform:translateX(2px); }
    .planner-add-task { display:flex; gap:7px; margin-top:24px; padding:8px 10px 8px 18px; border:1px solid rgba(255,255,255,.18); border-radius:20px; background:#17171a; }
    .planner-add-task input, .planner-note { width:100%; border:0; border-radius:8px; background:transparent; color:#fff; padding:10px; font:inherit; }
    .planner-add-task input:focus, .planner-note:focus { outline:none; border-color:#00f2ea; }
    .planner-add-task button { border:0; border-radius:18px; padding:0 20px; background:#3e4a9c; color:#cbd0ff; cursor:pointer; font-weight:800; }
    .planner-note-wrap { margin-top:20px; padding-top:16px; border-top:1px solid rgba(255,255,255,.1); }
    .planner-save-state { color:#666; font-size:.7rem; }
    .planner-note { min-height:130px; margin-top:10px; resize:vertical; line-height:1.6; border:1px solid rgba(255,255,255,.11); background:linear-gradient(135deg,#1a1b1e,#111214); }
    .planner-note-display { margin-top:10px; padding:14px 16px; border:1px solid rgba(255,255,255,.1); border-radius:12px; background:linear-gradient(135deg,#1a1b1e,#111214); color:#d9dbde; line-height:1.7; white-space:pre-wrap; overflow-wrap:anywhere; }
    .planner-note-display.is-empty { color:#73737d; font-style:italic; }
    .planner-note-actions { display:flex; align-items:center; gap:8px; }
    .planner-note-save { display:block; margin:10px 0 0 auto; border:0; border-radius:8px; padding:8px 15px; background:#a7a8ff; color:#11111a; cursor:pointer; font-weight:800; }
    .planner-edit-button { width:30px; height:30px; display:grid; place-items:center; border:0; background:transparent; color:#a7a8ff; cursor:pointer; font-size:1rem; }
    .planner-edit-button svg { width:16px; height:16px; }
    .planner-edit-button:hover { color:#fff; }
    .planner-readonly { opacity:.78; }
    .focus-timer-actions button { position:relative; }
    .focus-timer-actions button::after { content:'Play / Pause (P)'; position:absolute; left:50%; bottom:calc(100% + 10px); transform:translate(-50%, 4px); padding:7px 9px; border:1px solid rgba(255,255,255,.14); border-radius:7px; background:#111; color:#fff; font-size:.7rem; font-weight:600; white-space:nowrap; opacity:0; pointer-events:none; transition:opacity .16s ease, transform .16s ease; }
    .focus-timer-actions button:hover::after, .focus-timer-actions button:focus-visible::after { opacity:1; transform:translate(-50%, 0); }

    .focus-timer-panel {
      display: flex; align-items: center; justify-content: space-between; gap: 24px;
      margin-bottom: 25px; padding: 22px 25px;
      background: linear-gradient(135deg, rgba(0, 242, 234, 0.08), rgba(20, 20, 20, 0.7));
      border: 1px solid rgba(0, 242, 234, 0.16); border-radius: var(--card-radius);
    }
    .focus-timer-copy h2 { margin: 0 0 5px; font-size: 1.15rem; }
    .focus-timer-copy p { margin: 0; color: #888; font-size: 0.85rem; }
    .focus-timer-display { display: flex; align-items: center; gap: 18px; }
    #focus-timer-value { min-width: 92px; color: var(--neon-blue); font-size: 2rem; font-variant-numeric: tabular-nums; text-align: center; }
    .focus-timer-actions { display: flex; gap: 8px; }
    .focus-timer-actions button { border: 0; border-radius: 10px; padding: 10px 16px; font-weight: 700; cursor: pointer; }
    #focus-start { background: var(--neon-blue); color: #041414; }
    #focus-stop { background: #ff0055; color: #fff; }
    #focus-timer-status { min-width: 150px; color: #777; font-size: 0.78rem; }
    #focus-timer-status[data-state="running"] { color: var(--neon-blue); }
    #focus-timer-status[data-state="pending"] { color: var(--neon-gold); }
    @media (max-width: 600px) {
      .focus-timer-panel, .focus-timer-display { align-items: flex-start; flex-direction: column; }
      .focus-timer-display { width: 100%; gap: 10px; }
      .focus-timer-actions { width: 100%; }
      .focus-timer-actions button { flex: 1; }
    }
    
    .card-panel {
      background: var(--glass-surface); border: var(--glass-border);
      border-radius: var(--card-radius); padding: 25px;
      display: flex; flex-direction: column;
    }

    .card-head { display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 20px; }
    .card-title { font-size: 1.1rem; font-weight: 700; display: flex; align-items: center; gap: 10px; color: #fff;
    }
    .card-title svg { color: var(--neon-blue); opacity: 0.9;
    }

    /* Focus Wheel */
    .focus-display { display: flex; flex-direction: column; align-items: center;
      justify-content: center; flex: 1; }
    .wheel-outer {
      width: 170px; height: 170px;
      border-radius: 50%;
      background: conic-gradient(#333 0deg, #333 360deg);
      display: flex; align-items: center; justify-content: center;
      position: relative; margin-bottom: 15px;
      box-shadow: 0 0 40px rgba(0,0,0,0.2);
    }
    .wheel-outer::after { content: ''; position: absolute; width: 140px; height: 140px;
      background: #121212; border-radius: 50%; }
    .wheel-inner { position: relative; z-index: 2; text-align: center;
    }
    .wheel-val { font-size: 2.5rem; font-weight: 800; line-height: 1; color: #fff;
    }
    .wheel-lbl { font-size: 0.75rem; color: #666; font-weight: 700; text-transform: uppercase; margin-top: 5px;
    }
    
    .goal-text-gradient {
      font-size: 1.25rem; font-weight: 800;
      background: linear-gradient(135deg, #fff 0%, #aaa 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      margin-bottom: 5px;
    }

    /* Momentum Chart */
    .chart-box { display: flex; justify-content: space-between; align-items: flex-end;
      height: 150px; gap: 12px; margin-top: auto; }
    .chart-col { flex: 1; display: flex; flex-direction: column; align-items: center;
      height: 100%; justify-content: flex-end; }
    .bar-wrapper { width: 100%; height: 100%; background: rgba(255,255,255,0.03); border-radius: 8px; position: relative;
      overflow: hidden; display: flex; align-items: flex-end; }
    .bar-fill { width: 100%; min-height: 4px;
      border-radius: 8px 8px 0 0; transition: height 0.8s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .bar-fill.high { background: #4ade80;
      box-shadow: 0 0 20px rgba(74, 222, 128, 0.25); }
    .bar-fill.med { background: #FFD700;
      box-shadow: 0 0 20px rgba(255, 215, 0, 0.25); }
    .bar-fill.low { background: #ef4444;
    }
    .col-label { margin-top: 10px; font-size: 0.8rem; font-weight: 600; color: #777;
    }
    .col-val { font-size: 0.85rem; font-weight: 700; margin-bottom: 8px; color: #fff;
    }

    /* --- 4. Streak Stats --- */
    .streak-deck {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px;
      margin-bottom: 24px; padding:8px; position: relative; z-index: 1;
      border:1px solid rgba(255,255,255,.1); border-radius:18px;
      background:rgba(255,255,255,.035);
    }
    .streak-card {
      background:rgba(7,7,9,.62);
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 12px; padding: 10px 12px;
      display: flex; align-items: center; gap: 9px;
      transition: var(--transition-fast);
    }
    .streak-card:hover { transform: translateY(-2px);
      border-color: rgba(255,255,255,.16); }
    
    .s-icon { width:30px; height:30px; display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0; }
    .si-fire { color:#f29b62; }
    .si-star { color:#d9bd69; }
    .si-trophy { color:#aeb7c4; }
    .si-crown { color:#84c7c2; }

    .s-data h4 { font-size: 0.62rem; color: #888; text-transform: uppercase; margin-bottom: 1px; font-weight: 700; line-height:1.2;
    }
    .s-data .num { font-size: 1.1rem; font-weight: 800; color: #fff;
    }
    .today-focus-panel { margin-bottom:20px; }

    /* --- 5. Bottom Section --- */
    .bottom-split {
      display: grid;
      grid-template-columns: 2fr 1fr; gap: 25px; position: relative; z-index: 1;
    }

    .log-list { list-style: none; margin-top: 10px;
    }
    .log-entry {
      display: flex; justify-content: space-between; align-items: center;
      padding: 16px 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .log-entry:last-child { border-bottom: none; }
    .le-left { display: flex;
      align-items: center; gap: 15px; }
    .date-sq {
      background: #1a1a1a;
      border: 1px solid #333; padding: 5px 10px; border-radius: 10px;
      text-align: center; min-width: 55px;
    }
    .ds-mo { font-size: 0.65rem; color: #777; text-transform: uppercase; display: block; font-weight: 700;
    }
    .ds-dy { font-size: 1.1rem; font-weight: 800; color: #fff;
    }
    
    .le-info-h { font-size: 1rem; font-weight: 700; color: #eee;
    }
    .le-info-status { font-size: 0.75rem; display: flex; align-items: center; gap: 6px; margin-top: 4px; font-weight: 600;
    }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; }

    .action-panel { display: flex;
      flex-direction: column; gap: 15px; }

    .total-stat-box {
      background: linear-gradient(135deg, #181818, #0a0a0a);
      border: 1px solid rgba(255, 215, 0, 0.1);
      border-radius: 18px; padding: 20px; text-align: center;
    }
    .ts-label { font-size: 0.75rem; color: #888; text-transform: uppercase; letter-spacing: 1px;
    }
    .ts-val { font-size: 2.2rem; font-weight: 800; color: var(--neon-gold); margin-top: 5px;
    }

    /* Achievement Hero Button */
    .btn-hero-achieve {
      background: linear-gradient(135deg, rgba(255,215,0,0.1), rgba(255,165,0,0.05));
      border: 1px solid rgba(255, 215, 0, 0.4);
      padding: 20px; border-radius: 16px;
      display: flex; align-items: center; justify-content: space-between;
      text-decoration: none;
      color: #fff;
      box-shadow: 0 0 20px rgba(255, 215, 0, 0.1);
      transition: var(--transition-smooth);
      position: relative; overflow: hidden;
    }
    .btn-hero-achieve:hover {
      box-shadow: 0 0 30px rgba(255, 215, 0, 0.25);
      border-color: var(--neon-gold);
      transform: translateY(-2px);
    }
    .hero-content { display: flex; align-items: center; gap: 12px;
    }
    .hero-icon { font-size: 1.5rem; }
    .hero-text-main { font-size: 1.2rem; font-weight: 800; color: var(--neon-gold);
    }
    .hero-text-sub { font-size: 0.8rem; color: #aaa; margin-top: 2px; }
    .hero-arrow { color: var(--neon-gold);
      font-size: 1.2rem; }
    
    .btn-secondary {
      background: var(--glass-surface);
      border: var(--glass-border);
      padding: 15px 20px; border-radius: 14px;
      display: flex; align-items: center; justify-content: space-between;
      text-decoration: none; color: #ccc; transition: var(--transition-fast);
      font-weight: 600;
    }
    .btn-secondary:hover { background: rgba(255,255,255,0.08); color: #fff; transform: translateX(3px);
    }

    /* Responsive */
    @media (max-width: 1000px) { .dashboard-workspace { grid-template-columns:1fr; } .dashboard-side { order:1; } .planner-panel { order:2; min-height:0; } }
    @media (max-width: 900px) { .dashboard-grid, .bottom-split { grid-template-columns: 1fr; } }
    
    @media (max-width: 600px) {
      .dashboard-workspace { display:flex; flex-direction:column; align-items:stretch; gap:16px; width:100%; }
      .dashboard-workspace > .planner-panel { order:3; }
      .dashboard-workspace > .dashboard-side { display:contents; }
      .dashboard-workspace .focus-timer-panel,
      .dashboard-workspace .today-focus-panel,
      .dashboard-workspace .streak-deck,
      .dashboard-workspace .action-panel,
      .dashboard-workspace > .planner-panel { width:100%; min-width:0; max-width:none; }
      .dashboard-workspace .focus-timer-panel { order:1; }
      .dashboard-workspace .today-focus-panel { order:2; }
      .dashboard-workspace .streak-deck { order:4; }
      .dashboard-workspace .action-panel { order:5; }
      .container { padding: 0 6px 80px 6px; }
      .planner-panel { padding:22px 16px; border-radius:22px; }
      .planner-heading { flex-direction:column-reverse; }
      .planner-date-controls { width:100%; justify-content:space-between; }
      .streak-deck { grid-template-columns: 1fr 1fr; gap: 6px; padding:6px; }
      .streak-card { padding: 9px 8px; flex-direction: column; text-align: center; gap: 5px; }
      .s-data { width: 100%; display: flex; flex-direction: column; align-items: center; }
      .hero-text h1 { font-size: 1.8rem; }
    }
    .dashboard-side .focus-timer-panel { min-height:238px; margin-bottom:18px; padding:28px; flex-direction:column; align-items:stretch; justify-content:space-between; position:relative; }
    .focus-timer-panel:fullscreen { width:100vw; height:100vh; min-height:100vh; margin:0; border-radius:0; justify-content:center; align-items:center; gap:38px; background:#070707; }
    .focus-timer-panel:fullscreen .focus-timer-copy, .focus-timer-panel:fullscreen .focus-timer-display { width:min(620px,90vw); }
    .focus-fullscreen { position:absolute; top:14px; right:14px; width:34px; height:34px; display:grid; place-items:center; border:1px solid rgba(255,255,255,.13); border-radius:8px; background:rgba(255,255,255,.05); color:#aaa; cursor:pointer; }
    .focus-fullscreen:hover { color:#fff; background:rgba(255,255,255,.12); }
    .focus-fullscreen svg { width:17px; height:17px; }
    .dashboard-side .focus-timer-copy h2 { font-size:1.25rem; }
    .dashboard-side .focus-timer-display { justify-content:space-between; align-items:flex-end; }
    .dashboard-side .focus-timer-panel {
      min-height:190px;
      padding:20px;
      gap:16px;
      border-radius:20px;
    }
    .dashboard-side .focus-timer-copy h2 { font-size:1.05rem; }
    .dashboard-side .focus-timer-copy p { font-size:.76rem; }
    .dashboard-side #focus-timer-status { min-width:0; font-size:.7rem; }
    .dashboard-side .focus-timer-display { gap:12px; }
    .dashboard-side #focus-timer-value { min-width:78px; font-size:2.35rem; }
    .dashboard-side .focus-timer-actions button { width:44px; height:44px; padding:10px; }
    .dashboard-side .focus-timer-actions svg { width:20px; height:20px; }
    .focus-timer-panel:fullscreen {
      display:flex;
      flex-direction:column;
      justify-content:center;
      align-items:center;
      gap:clamp(20px, 4vh, 48px);
      padding:clamp(24px, 5vw, 80px);
      background:radial-gradient(circle at 50% 42%, rgba(0,242,234,.12), transparent 38%), #070707;
    }
    .focus-timer-panel:fullscreen .focus-timer-copy,
    .focus-timer-panel:fullscreen .focus-timer-display { width:min(86vw, 980px); }
    .focus-timer-panel:fullscreen .focus-timer-copy { text-align:center; }
    .focus-timer-panel:fullscreen .focus-timer-copy h2 { font-size:clamp(1.5rem, 3vw, 3rem); }
    .focus-timer-panel:fullscreen .focus-timer-copy p { font-size:clamp(.9rem, 1.5vw, 1.25rem); }
    .focus-timer-panel:fullscreen #focus-timer-status { display:block; margin-top:clamp(8px, 2vh, 20px); font-size:clamp(.8rem, 1.2vw, 1.1rem); }
    .focus-timer-panel:fullscreen .focus-timer-display { flex-direction:column; align-items:center; gap:clamp(22px, 5vh, 58px); }
    .focus-timer-panel:fullscreen #focus-timer-value { min-width:0; font-size:clamp(3.5rem, 9vw, 7rem); line-height:.9; letter-spacing:.02em; }
    .focus-timer-panel:fullscreen .focus-timer-actions button { width:clamp(58px, 6vw, 88px); height:clamp(58px, 6vw, 88px); flex:0 0 clamp(58px, 6vw, 88px); padding:clamp(13px, 1.2vw, 20px); border-radius:50%; }
    .focus-timer-panel:fullscreen .focus-timer-actions svg { width:100%; height:100%; }
    .focus-timer-panel:fullscreen .focus-fullscreen { top:clamp(16px, 3vw, 42px); right:clamp(16px, 3vw, 42px); width:clamp(38px, 4vw, 56px); height:clamp(38px, 4vw, 56px); }
    .focus-timer-panel:fullscreen .focus-fullscreen svg { width:clamp(18px, 2vw, 28px); height:clamp(18px, 2vw, 28px); }
    .dashboard-side #focus-timer-value { font-size:3rem; }
    .focus-timer-actions button { width:48px; height:48px; display:grid; place-items:center; padding:0; border-radius:50%; }
    .focus-timer-actions button svg { width:20px; height:20px; }
    .focus-timer-actions button:hover { transform:translateY(-2px); filter:brightness(1.12); }
    .dashboard-side .focus-timer-panel:not(:fullscreen) #focus-timer-value { min-width:78px; font-size:2.35rem; }
    .dashboard-side .focus-timer-panel:not(:fullscreen) .focus-timer-actions button { width:44px; height:44px; }
    @media (max-width:800px) {
      .dashboard-side .focus-timer-actions { display:flex; width:100%; align-items:center; gap:10px; }
      .dashboard-side .focus-timer-actions button { width:clamp(36px, 11vw, 44px); height:clamp(36px, 11vw, 44px); flex:0 0 clamp(36px, 11vw, 44px); padding:8px; aspect-ratio:1; }
      .dashboard-side .focus-timer-actions button svg { width:100%; height:100%; }
    }
    .quick-log-options { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .quick-log-options .form-group { margin-bottom:0; }
    .log-mode-toggle { display:flex; gap:4px; padding:4px; border:1px solid rgba(255,255,255,.12); border-radius:10px; background:#111; }
    .log-mode-toggle button { flex:1; border:0; border-radius:7px; padding:9px 10px; background:transparent; color:#888; font-weight:800; cursor:pointer; }
    .log-mode-toggle button.active { background:#7653e8; color:#fff; }
    .focus-log-modal { max-width:480px; padding:30px; border:1px solid rgba(167,168,255,.25); border-radius:24px; background:linear-gradient(145deg,#1a1a22,#0c0c10 78%); box-shadow:0 25px 80px rgba(0,0,0,.55); }
    .focus-log-modal h2 { margin:0 0 7px; color:#fff; font-size:1.35rem; letter-spacing:-.02em; }
    .focus-log-subtitle { margin:0 0 24px; color:#888995; font-size:.82rem; }
    .focus-log-modal .modal-close { top:18px; right:20px; width:30px; height:30px; display:grid; place-items:center; border-radius:50%; color:#85859a; font-size:1.45rem; line-height:1; }
    .focus-log-modal .modal-close:hover { background:rgba(255,255,255,.08); color:#fff; }
    .focus-log-modal .form-group { margin-bottom:18px; }
    .focus-log-modal .form-group label { display:block; margin-bottom:8px; color:#b9b9c7; font-size:.74rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; }
    .focus-log-modal input[type="number"], .focus-log-modal input[type="date"] { width:100%; padding:12px 13px; border:1px solid rgba(255,255,255,.12); border-radius:11px; background:#101015; color:#fff; box-sizing:border-box; font:inherit; color-scheme:dark; }
    .focus-log-modal input:focus { outline:2px solid rgba(167,168,255,.35); border-color:#a7a8ff; }
    .focus-log-modal .log-mode-toggle { border-color:rgba(167,168,255,.2); background:#101015; }
    .focus-log-modal .log-mode-toggle button { color:#88899a; }
    .focus-log-modal .log-mode-toggle button.active { background:#a7a8ff; color:#11111a; }
    .focus-log-submit { width:100%; margin-top:6px; padding:12px 16px; border:0; border-radius:12px; background:#a7a8ff; color:#11111a; font:inherit; font-weight:800; cursor:pointer; transition:filter .2s ease,transform .2s ease; }
    .focus-log-submit:hover:not(:disabled) { filter:brightness(1.1); transform:translateY(-1px); }
    .focus-log-submit:disabled { cursor:wait; opacity:.7; }
    @media (max-width:800px) { .dashboard-side .focus-timer-panel, .dashboard-side .focus-timer-display { align-items:flex-start; flex-direction:column; } .dashboard-side .focus-timer-display { width:100%; gap:10px; } }
  </style>
</head>
<body>
  <%- include('partials/loader') %>
  
  <%- include('partials/app-header') %>

  <div class="container">
    
    <div class="dashboard-hero">
      <div class="hero-text">
        <h1>Welcome, <%= user.name %></h1>
        <p>Ready to level up your productivity today?</p>
      </div>
      <button id="open-track-modal" class="btn-log-session">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/></svg>
        Log Focus <%= user.timeUnit === 'hours' ? 'Hours' : 'Minutes' %>
      </button>
    </div>

    <%
      const rawTodayMinutes = typeof todayMinutes !== 'undefined' && Number.isFinite(Number(todayMinutes))
        ? Number(todayMinutes)
        : 0;
      const displayedTodayMinutes = Math.round(rawTodayMinutes);
      const goal = user.dailyGoalMinutes || 300;
      let focusColor = '#ef4444';
      if (displayedTodayMinutes >= goal) focusColor = '#4ade80';
      else if (displayedTodayMinutes > 0) focusColor = '#FFD700';
      const percentage = Math.round((displayedTodayMinutes / goal) * 100);
      const focusDeg = Math.min((displayedTodayMinutes / goal) * 360, 360);
      let percentageText = percentage + "% Complete";
      if(percentage >= 100) percentageText = percentage + "% (Goal Met)";
      if(percentage === 0) percentageText = "0% Started";
    %>
    <div class="dashboard-workspace">
      <section class="planner-panel" id="daily-planner">
        <div class="planner-heading">
          <div class="planner-date-controls">
            <button type="button" id="planner-prev" aria-label="Previous date">&lsaquo;</button>
            <span id="planner-date-label" class="planner-date-label">Today</span>
            <button type="button" id="planner-next" aria-label="Next date">&rsaquo;</button>
            <span class="planner-date-picker"><button type="button" aria-label="Choose date"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 9h18M8 3v4M16 3v4M7 13h.01M12 13h.01M17 13h.01M7 17h.01M12 17h.01M17 17h.01" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><input id="planner-date" type="date" aria-label="Choose planner date"></span>
          </div>
          <div><h2>Today's Tasks <span id="planner-progress">0%</span></h2><p><span id="planner-task-count">0 of 0 tasks completed</span></p></div>
        </div>
        <div class="planner-list-heading"><h3>Todo list</h3></div>
        <div id="planner-task-list" class="planner-task-list"></div>
        <form id="planner-task-form" class="planner-add-task">
          <input id="planner-task-input" type="text" maxlength="240" placeholder="Add a task for this list" autocomplete="off">
          <button type="submit" aria-label="Add task">+</button>
        </form>
        <div class="planner-note-wrap">
          <div class="planner-note-heading"><h3>Note for the day</h3><div class="planner-note-actions"><span id="planner-save-state" class="planner-save-state">Saved</span><button type="button" id="planner-edit" class="planner-edit-button" aria-label="Edit note" title="Edit note" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m4 16 0-4L15 1l4 4L8 16H4Z"></path><path d="m13 3 4 4M4 20h16"></path></svg></button></div></div>
          <div id="planner-note-display" class="planner-note-display" hidden></div>
          <textarea id="planner-note" class="planner-note" maxlength="10000" placeholder="What did you study, accomplish, or learn?"></textarea>
          <button type="button" id="planner-note-save" class="planner-note-save" hidden>Save</button>
        </div>
      </section>

      <div class="dashboard-side">
      <section class="focus-timer-panel animate-up delay-1" id="focus-timer" data-user-id="<%= user.userId %>" data-time-unit="<%= user.timeUnit || 'minutes' %>" data-goal-minutes="<%= goal %>" data-today-log-minutes="<%= todayLogMinutes %>" data-today-focus-seconds="<%= typeof todayFocusSeconds !== 'undefined' ? todayFocusSeconds : 0 %>">
        <button type="button" class="focus-fullscreen" id="focus-fullscreen" aria-label="Enter fullscreen timer" title="Enter fullscreen timer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M21 16v5h-5"/></svg></button>
        <div class="focus-timer-copy">
          <h2>Focus session</h2>
          <p>Start when you begin. Stop when you finish.</p>
          <span id="focus-timer-status" aria-live="polite">Ready to focus</span>
        </div>
        <div class="focus-timer-display">
          <strong id="focus-timer-value" aria-live="off">00:00</strong>
          <div class="focus-timer-actions">
            <button type="button" id="focus-toggle" aria-label="Start focus timer" title="Play / Pause (P)"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.53.85l10.1-6.86a1 1 0 0 0 0-1.7L9.53 4.29A1 1 0 0 0 8 5.14Z"/></svg></button>
          </div>
        </div>
      </section>
      <div class="card-panel today-focus-panel">
        <div class="card-head"><div class="card-title">Today's Focus</div><span style="font-size:.9rem;color:#888;">Goal: <%= formatMinutes(goal, user.timeUnit) %></span></div>
        <div class="focus-display"><div class="wheel-outer" id="today-focus-wheel" style="background:conic-gradient(<%= focusColor %> <%= focusDeg %>deg, #1c1c1c 0deg);"><div class="wheel-inner"><div class="wheel-val" id="today-focus-minutes" style="color:<%= focusColor %>"><%= formatMinutes(displayedTodayMinutes, user.timeUnit) %></div><div class="wheel-lbl"><%= user.timeUnit === 'hours' ? 'HOURS' : 'MINUTES' %></div></div></div><div class="goal-text-gradient" id="today-focus-progress"><%= percentageText %></div></div>
      </div>
      <div class="streak-deck animate-up delay-2">
        <div class="streak-card">
          <!-- legacy fragment
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path d="M10.854 7.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 9.793l2.646-2.647a.5.5 0 0 1 .708 0z"/><path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 
          -->
           <div class="s-icon si-fire" aria-hidden="true"><i class="bi bi-fire"></i></div>
           <div class="s-data">
             <h4>Current Consistency</h4>
             <div class="num animate-num" data-suffix=" days"><%= currentConsistencyStreak %> days</div>
           </div>
        </div>
        <div class="streak-card">
    
           <div class="s-icon si-star" aria-hidden="true"><i class="bi bi-bullseye"></i></div>
           <div class="s-data">
             <h4>Current Goal Streak</h4>
             <div class="num animate-num" data-suffix=" days"><%= currentGoalStreak %> days</div>
           </div>
        </div>
        <div class="streak-card">
           <div class="s-icon si-trophy" aria-hidden="true"><i class="bi bi-trophy"></i></div>
   
           <div class="s-data">
             <h4>Max Consistency Streak</h4>
             <div class="num animate-num" data-suffix=" days"><%= maxConsistencyStreak %> days</div>
           </div>
        </div>
        <div class="streak-card">
           <div class="s-icon si-crown" aria-hidden="true"><i class="bi bi-gem"></i></div>
           <div class="s-data">
   
             <h4>Best Goal Streak</h4>
             <div class="num animate-num" data-suffix=" days"><%= maxGoalStreak %> days</div>
           </div>
        </div>
    </div>

     <div class="action-panel animate-up delay-3">
          
          <div class="total-stat-box">
 
             <% const rawDisplayedTotalMinutes = typeof totalMinutes !== 'undefined' && Number.isFinite(Number(totalMinutes)) ? Number(totalMinutes) : 0; %>
             <% const displayedTotalMinutes = Math.round(rawDisplayedTotalMinutes); %>
             <div class="ts-label">All Time Focus <%= user.timeUnit === 'hours' ? 'Hours' : 'Minutes' %></div>
             <div class="ts-val animate-num" data-suffix="<%= user.timeUnit === 'hours' ? 'h' : 'm' %>" data-time-unit="<%= user.timeUnit || 'minutes' %>" data-total-focus-minutes="<%= rawDisplayedTotalMinutes %>"><%= formatMinutes(displayedTotalMinutes, user.timeUnit) %></div>
          </div>

          <a href="/achievements" class="btn-hero-achieve">
             <div class="hero-content">
                <span class="hero-icon">🏆</span>
             
               <div>
                   <div class="hero-text-main">Achievements</div>
                   <% if(achievementCount > 0) { %>
                     <div class="hero-text-sub" style="color:#ff5722;"><%= achievementCount %> Unclaimed!</div>
                   <% } else { %>
    
                     <div class="hero-text-sub">View Progress</div>
                   <% } %>
                </div>
             </div>
             <span class="hero-arrow">→</span>
          </a>
       
          
          <a href="/settings" class="btn-secondary">
            <span>⚙️ Update Goal</span>
             <span>→</span>
          </a>

       </div>
    </div>
    </div>
    </div>

  </div> <div id="trackModal" class="modal-overlay">
    <div class="modal-content focus-log-modal">
        <span class="modal-close" id="close-track-modal">&times;</span>
        <h2>Log focus time</h2>
        <p class="focus-log-subtitle">Track the time you spent building momentum.</p>
          <form id="quickLogForm">
            <input type="hidden" name="timeUnit" value="<%= user.timeUnit || 'minutes' %>">
            <div class="quick-log-options">
              <div class="form-group"><label>Update mode</label><div class="log-mode-toggle" role="group" aria-label="Focus update mode"><button type="button" class="active" data-log-mode="add">Add</button><button type="button" data-log-mode="reset">Reset</button></div><input type="hidden" id="modal-mode" name="mode" value="add"></div>
              <div class="form-group"><label for="modal-minutes"><%= user.timeUnit === 'hours' ? 'Hours focused' : 'Minutes focused' %></label>
                <input type="number" id="modal-minutes" name="minutes" step="<%= user.timeUnit === 'hours' ? '0.1' : '1' %>" min="0" max="<%= user.timeUnit === 'hours' ? '24' : '1440' %>" required>
              </div>
            </div>
            <div class="form-group">
                <label for="modal-date">Date</label>
                <input type="date" id="modal-date" name="date" required>
            </div>
            <button type="submit" class="focus-log-submit">Save focus log</button>
        </form>
    </div>
  </div>

  <div id="xp-history-popup" class="xp-popup">
      <div class="xp-popup-content">
        <span class="xp-popup-close" id="xp-popup-close">&times;</span>
        <h2>XP Credit History</h2>
        <div id="xp-history-list" class="xp-history-list"></div>
      </div>
  </div>
      <footer style="padding: 50px 15px;text-align: center;border-top: 1px solid var(--border-light);">
        <p style="color: #666;">&copy; 2025 Focus tracker. All rights reserved. <a href="mailto:tracku.contact@gmail.com" style="color:rgb(115, 115, 115);">Message our suggestion/queries</a></p>
    </footer>

  <script src="/js/achievements.js" defer></script>
  <script src="/js/dashboard.js" defer></script>
  <script src="/js/planner.js" defer></script>
  <script>
    // Modal & Form Logic
    const trackModal = document.getElementById('trackModal');
    const openTrackBtn = document.getElementById('open-track-modal');
    const 
    closeTrackBtn = document.getElementById('close-track-modal');
    const quickLogForm = document.getElementById('quickLogForm');
    const modalDate = document.getElementById('modal-date');
    
    openTrackBtn.addEventListener('click', () => {
        trackModal.style.display = 'flex';
        modalDate.value = new Date().toISOString().split('T')[0];
    });
    closeTrackBtn.addEventListener('click', () => { trackModal.style.display = 'none';
    });
    
    window.addEventListener('click', (e) => {
        if (e.target === trackModal) trackModal.style.display = 'none';
        const xpPopup = document.getElementById('xp-history-popup');
        if (e.target === xpPopup) xpPopup.style.display = 'none';
    });
    quickLogForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = quickLogForm.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerText;
      const mode = document.getElementById('modal-mode').value;
      submitBtn.innerText = mode === 'reset' ? "Resetting..." : "Saving...";
        submitBtn.disabled = true;
        const formData = new URLSearchParams(new FormData(quickLogForm));
        try {
            const response = await fetch('/add-study-log', {
          
                method: 'POST',
                body: formData,
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' }
            });
            if (!response.ok) throw new Error('Unable to save focus log');
            const result = await response.json();
            if (window.focusTrackerSyncToday) window.focusTrackerSyncToday(result);
            trackModal.style.display = 'none';
            submitBtn.innerText = originalText;
            submitBtn.disabled = false;
        } catch (err) {
            console.error(err);
        
            alert('Failed to save log');
            submitBtn.innerText = originalText;
            submitBtn.disabled = false;
        }
    });
    quickLogForm.querySelectorAll('[data-log-mode]').forEach(button => button.addEventListener('click', () => {
      quickLogForm.querySelectorAll('[data-log-mode]').forEach(item => item.classList.toggle('active', item === button));
      document.getElementById('modal-mode').value = button.dataset.logMode;
      const submitBtn = quickLogForm.querySelector('button[type="submit"]');
      if (submitBtn && !submitBtn.disabled) submitBtn.innerText = button.dataset.logMode === 'reset' ? 'Reset focus log' : 'Save focus log';
    }));
    // XP Popup Logic
    const xpCounter = document.getElementById('xp-counter');
    const xpPopup = document.getElementById('xp-history-popup');
    const xpPopupClose = document.getElementById('xp-popup-close');
    const xpHistoryList = document.getElementById('xp-history-list');
    
    if(xpCounter) {
        xpCounter.addEventListener('click', async () => {
          try {
            const response = await fetch('/api/xp-history');
            const data = await response.json();
            let html = '<h3>Achievements</h3><ul>';
            if (data.achievements.length > 0) { data.achievements.forEach(item => { html += `<li>${item}</li>`; }); } 
            
            else { html += '<li>No achievement XP earned yet.</li>'; }
            html += '</ul><h3>Study Logs</h3><ul>';
            if (data.logs.length > 0) { data.logs.forEach(item => { html += `<li>${item}</li>`; }); } 
            else { html += '<li>No study XP earned yet.</li>'; }
            html += '</ul>';
    
            xpHistoryList.innerHTML = html;
            xpPopup.style.display = 'block';
          } catch (error) {
            console.error('Failed to fetch XP history:', error);
            xpHistoryList.innerHTML = '<p>Could not load XP history.</p>';
            xpPopup.style.display = 'block';
          }
    
        });
    }
    if(xpPopupClose) {
        xpPopupClose.addEventListener('click', () => { xpPopup.style.display = 'none'; });
    }

    // Animations
    document.addEventListener('DOMContentLoaded', () => {
        const stats = document.querySelectorAll('.animate-num');
        stats.forEach(stat => {
            const originalText = stat.innerText;
            const suffix = stat.getAttribute('data-suffix') || '';
            const target = parseFloat(originalText.replace(/[^0-9.]/g, ''));
            if (isNaN(target)) return;
          
            let start = 0;
            const duration = 1500;
            const startTime = performance.now();

            function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
        
                const easeOut = 1 - Math.pow(1 - progress, 3);
                const current = start + (target - start) * easeOut;
                
                if (originalText.includes('.')) { stat.innerText = current.toFixed(1) + suffix;
                } 
                else { stat.innerText = Math.floor(current) + suffix;
                }
                
                if (progress < 1) { requestAnimationFrame(update);
                } 
                else { stat.innerText = originalText;
                }
            }
            setTimeout(() => requestAnimationFrame(update), 100);
        });
    });
  </script>
</body>
</html>