<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Productivity Tracker</title>
  
  <link rel="preload" href="/css/style.css" as="style">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  
  <style>
    /* Inline overrides */
    .lazy-render-box { content-visibility: auto; contain-intrinsic-size: 300px; }
    .container { margin-top: 0 !important; padding-top: 0 !important; }
    /* Gap utility */
    .mt-large { margin-top: 50px; }
  </style>
</head>
<body>
  <%- include('partials/analytics') %>
  <%- include('partials/loader') %>
  <nav class="navbar">
    <h2>Productivity Tracker</h2>
    <div class="nav-links">
      <a href="/dashboard" class="active">Dashboard</a>
      <a href="/calendar">⭐️ Calendar</a>
      <a href="/analytics">Analytics</a>
      <a href="/settings">Settings</a>
      <a href="/logout">Logout</a>
    </div>
  </nav>

  <div class="dashboard-header">
    <div class="dashboard-header-inner" style="display:flex; justify-content:center; flex-direction:column; align-items:center;">
        <h1>Welcome, <%= user.name %>!</h1>
        <p style="opacity: 0.8; margin-top: -5px;">Track your daily productivity and reach your goals</p>
        
        <button id="open-track-modal" class="track-btn-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
            </svg>
            Add Study Hours
        </button>
    </div>
  </div>

  <div class="container">
    
    <div class="user-stats-bar">
      <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 10px;">
          <div class="level-display">Level <%= user.level %></div>
          
          <div class="xp-container" id="xp-container">
              <div class="xp-counter" id="xp-counter">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-star-fill" viewBox="0 0 16 16">
                    <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                  </svg>
                  <span class="animate-num" data-suffix=" XP"><%= user.xp %> XP</span>
              </div>
              
              <div class="info-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16">
                      <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                  </svg>
                  <div class="tooltip">
                      <p><strong style="color: #ffd700;">XP & Level Rules:</strong></p>
                      <hr style="border-color: rgba(255,255,255,0.1); margin: 5px 0;">
                      <ul>
                        <li>+10 XP per hour studied</li>
                        <li>+50 XP bonus for meeting daily goal</li>
                        <li>+100 XP for each new achievement</li>
                        <li>Levels scale every 1000 XP</li>
                      </ul>
                  </div>
              </div>
          </div>
      </div>
      
      <% 
        const XP_PER_LEVEL = 1000;
        const currentLevelXp = user.xp % XP_PER_LEVEL;
        const progressPercent = (currentLevelXp / XP_PER_LEVEL) * 100;
      %>
      <div class="xp-progress-bar-container" title="<%= currentLevelXp %> / <%= XP_PER_LEVEL %> XP to next level">
          <div class="xp-progress-fill" id="xp-progress-fill" data-width="<%= progressPercent %>"></div>
      </div>
      <div style="text-align: right; font-size: 0.7rem; color: #888; margin-top: 2px;">
          <%= currentLevelXp %> / <%= XP_PER_LEVEL %> XP to Level <%= user.level + 1 %>
      </div>
    </div>

    <div class="dashboard-split-grid">
        
        <%
          const goal = user.dailyGoalHours;
          let statusColor = '#ef4444'; // Red default
          let statusClass = 'status-red';
          
          if (todayHours > goal) {
             statusColor = '#4ade80'; // Green
             statusClass = 'status-green';
          } else if (todayHours >= goal) { 
             statusColor = '#FFD700'; // Yellow
             statusClass = 'status-yellow';
          }

          const percentage = Math.min((todayHours / goal) * 100, 100);
          const degrees = (percentage / 100) * 360;
          const remaining = Math.max(goal - todayHours, 0);
        %>

        <div class="today-card <%= statusClass %>">
            <h3>Today's Focus</h3>
            <div class="circular-loader" style="background: conic-gradient(<%= statusColor %> <%= degrees %>deg, rgba(255,255,255,0.05) 0deg);">
                <div class="loader-content">
                    <div class="loader-hours" style="color: <%= statusColor %>"><%= todayHours.toFixed(1) %>h</div>
                    <div class="loader-sub">of <%= goal %>h Goal</div>
                </div>
            </div>
            <div class="today-summary">
                <% if(remaining > 0) { %>
                    <span style="color: <%= statusColor %>"><%= remaining.toFixed(1) %>h Remaining</span>
                <% } else { %>
                    <span style="color: <%= statusColor %>">Goal Met! 🎉</span>
                <% } %>
            </div>
        </div>

        <div class="history-grid-container">
            <% 
              const getHistoryData = () => {
                const history = [];
                const now = new Date();
                const todayUTC = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));

                for(let i=1; i<=3; i++) {
                   const d = new Date(todayUTC);
                   d.setUTCDate(d.getUTCDate() - i);
                   
                   const log = recentLogs.find(l => {
                       const ld = new Date(l.date);
                       return ld.getTime() === d.getTime();
                   });
                   
                   const h = log ? log.hours : 0;
                   const g = user.dailyGoalHours || 1; 
                   
                   let pct = Math.round((h / g) * 100);
                   
                   // Color logic
                   let colorClass = 'text-red';
                   let barColor = '#ef4444';
                   if(pct >= 100) { colorClass = 'text-green'; barColor = '#4ade80'; }
                   else if(pct > 0) { colorClass = 'text-yellow'; barColor = '#ffd700'; }

                   // Date Parts
                   const weekday = d.toLocaleDateString('en-US', { weekday: 'short' }); 
                   const dayNum = d.getDate(); 
                   
                   history.push({
                     weekday,
                     dayNum,
                     hours: h,
                     pct: pct,
                     colorClass,
                     barColor,
                     barWidth: Math.min(pct, 100)
                   });
                }
                return history;
              };
              const historyData = getHistoryData();
            %>

            <% historyData.forEach(day => { %>
                <div class="history-card-row">
                    <div class="calendar-date-box">
                        <span class="cal-weekday"><%= day.weekday %></span>
                        <span class="cal-daynum"><%= day.dayNum %></span>
                    </div>

                    <div class="history-details">
                        <div class="history-meta">
                            <span class="history-hours-val"><%= day.hours.toFixed(1) %> hours</span>
                        </div>
                        <div class="history-progress-track">
                            <div class="history-progress-fill" style="width: <%= day.barWidth %>%; background-color: <%= day.barColor %>;"></div>
                        </div>
                    </div>

                    <div class="history-badge-container">
                         <span class="history-pct-badge <%= day.colorClass %>">
                            <%= day.pct %>%
                        </span>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <div class="stats-grid stats-grid-4">
        <div class="stat-card">
            <h3>Current Consistency</h3>
            <p class="stat-number animate-num" data-suffix=" days"><%= currentConsistencyStreak %> days</p>
        </div>
        <div class="stat-card">
            <h3>Current Goal Streak</h3>
            <p class="stat-number animate-num" data-suffix=" days"><%= currentGoalStreak %> days</p>
        </div>
        <div class="stat-card">
             <h3>Max Consistency</h3>
            <p class="stat-number animate-num" data-suffix=" days"><%= maxConsistencyStreak %> days</p>
        </div>
        <div class="stat-card">
            <h3>Max Goal Streak</h3>
            <p class="stat-number animate-num" data-suffix=" days"><%= maxGoalStreak %> days</p>
        </div>
    </div>

    <div class="quick-action full-width">
      <a href="/achievements" class="btn1">View My Achievements
        <% if (achievementCount > 0) { %>
          <span class="notification-badge"><%= achievementCount %></span>
        <% } %>
      </a>
    </div>

    <div class="stats-grid stats-grid-3 lazy-render-box mt-large">
      <div class="stat-card">
        <h3>Total Hours</h3>
        <p class="stat-number animate-num" data-suffix="h"><%= totalHours.toFixed(1) %>h</p>
        <div style="margin-top: 5px; color: #888; font-size: 0.9rem;">
            All Time Study
        </div>
      </div>

      <div class="stat-card">
        <h3>Recent Logs</h3>
        <p class="stat-number animate-num"><%= recentLogs.length %></p>
        <span style="color: #888;">Last 30 days</span>
      </div>

       <div class="stat-card" style="display: flex; justify-content: center; align-items: center; flex-direction: column;">
            <h3>Quick Actions</h3>
            <div style="margin-top: 15px;">
                 <a href="/calendar" class="btn" style="padding: 10px 20px; font-size: 0.9rem;">View Calendar</a>
            </div>
      </div>
    </div>

    <div class="recent-activity lazy-render-box">
      <h2>Recent Activity Log</h2>
      <% if (recentLogs.length > 0) { %>
        <div class="table-responsive">
            <table>
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Hours</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% recentLogs.slice(0, 10).forEach(log => { %>
                  <tr>
                    <td><%= log.date.toLocaleDateString() %></td>
                    <td><%= log.hours.toFixed(1) %>h</td>
                    <td>
                      <span class="badge <%= log.hours >= user.dailyGoalHours ? 'badge-green' : 'badge-red' %>">
                        <%= log.hours >= user.dailyGoalHours ? 'Goal Met' : 'Below Goal' %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
        </div>
      <% } else { %>
        <p>No activity recorded yet. Start tracking your productivity!</p>
      <% } %>
    </div>
  </div>

  <div id="trackModal" class="modal-overlay">
    <div class="modal-content">
        <span class="modal-close" id="close-track-modal">&times;</span>
        <h2 style="text-align: center; margin-bottom: 20px; color: #ffd700;">Add Study Hours</h2>
        <form id="quickLogForm">
            <div class="form-group" style="margin-bottom: 15px;">
                <label for="modal-date">Date</label>
                <input type="date" id="modal-date" name="date" required style="width: 100%; padding: 12px; background: #2a2a2a; border: 1px solid #444; color: white; border-radius: 8px; box-sizing: border-box;">
            </div>
            <div class="form-group" style="margin-bottom: 25px;">
                <label for="modal-hours">Hours Studied</label>
                <input type="number" id="modal-hours" name="hours" step="0.5" min="0" max="24" required style="width: 100%; padding: 12px; background: #2a2a2a; border: 1px solid #444; color: white; border-radius: 8px; box-sizing: border-box;">
            </div>
            <button type="submit" class="btn" style="width: 100%; font-size: 1.1rem; padding: 12px;">Save Log</button>
        </form>
    </div>
  </div>

  <div id="xp-history-popup" class="xp-popup">
      <div class="xp-popup-content">
        <span class="xp-popup-close" id="xp-popup-close">&times;</span>
        <h2>XP Credit History</h2>
        <div id="xp-history-list" class="xp-history-list"></div>
      </div>
  </div>

  <script src="/js/achievements.js" defer></script>
  <script>
    // Removed the total-hours-range event listener as element is gone

    const trackModal = document.getElementById('trackModal');
    const openTrackBtn = document.getElementById('open-track-modal');
    const closeTrackBtn = document.getElementById('close-track-modal');
    const quickLogForm = document.getElementById('quickLogForm');
    const modalDate = document.getElementById('modal-date');
    
    openTrackBtn.addEventListener('click', () => {
        trackModal.style.display = 'flex';
        modalDate.value = new Date().toISOString().split('T')[0];
    });
    closeTrackBtn.addEventListener('click', () => { trackModal.style.display = 'none'; });
    window.addEventListener('click', (e) => {
        if (e.target === trackModal) trackModal.style.display = 'none';
        const xpPopup = document.getElementById('xp-history-popup');
        if (e.target === xpPopup) xpPopup.style.display = 'none';
    });
    quickLogForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = quickLogForm.querySelector('button');
        const originalText = submitBtn.innerText;
        submitBtn.innerText = "Saving...";
        submitBtn.disabled = true;
        const formData = new URLSearchParams(new FormData(quickLogForm));
        try {
            await fetch('/add-study-log', {
                method: 'POST',
                body: formData,
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
            });
            window.location.reload(); 
        } catch (err) {
            console.error(err);
            alert('Failed to save log');
            submitBtn.innerText = originalText;
            submitBtn.disabled = false;
        }
    });

    // XP Popup Logic (Restored)
    const xpCounter = document.getElementById('xp-counter');
    const xpPopup = document.getElementById('xp-history-popup');
    const xpPopupClose = document.getElementById('xp-popup-close');
    const xpHistoryList = document.getElementById('xp-history-list');
    
    if(xpCounter) {
        xpCounter.addEventListener('click', async () => {
          try {
            const response = await fetch('/api/xp-history');
            const data = await response.json();
            let html = '<h3>Achievements</h3><ul>';
            if (data.achievements.length > 0) { data.achievements.forEach(item => { html += `<li>${item}</li>`; }); } 
            else { html += '<li>No achievement XP earned yet.</li>'; }
            html += '</ul><h3>Study Logs</h3><ul>';
            if (data.logs.length > 0) { data.logs.forEach(item => { html += `<li>${item}</li>`; }); } 
            else { html += '<li>No study XP earned yet.</li>'; }
            html += '</ul>';
            xpHistoryList.innerHTML = html;
            xpPopup.style.display = 'block';
          } catch (error) {
            console.error('Failed to fetch XP history:', error);
            xpHistoryList.innerHTML = '<p>Could not load XP history.</p>';
            xpPopup.style.display = 'block';
          }
        });
    }
    if(xpPopupClose) {
        xpPopupClose.addEventListener('click', () => { xpPopup.style.display = 'none'; });
    }

    document.addEventListener('DOMContentLoaded', () => {
        const xpFill = document.getElementById('xp-progress-fill');
        if(xpFill) {
            setTimeout(() => {
                const targetWidth = xpFill.getAttribute('data-width');
                xpFill.style.width = targetWidth + '%';
            }, 100); 
        }
        const stats = document.querySelectorAll('.animate-num');
        stats.forEach(stat => {
            const originalText = stat.innerText;
            const suffix = stat.getAttribute('data-suffix') || '';
            const target = parseFloat(originalText.replace(/[^0-9.]/g, ''));
            if (isNaN(target)) return;
            let start = 0;
            const duration = 1500;
            const startTime = performance.now();
            function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easeOut = 1 - Math.pow(1 - progress, 3);
                const current = start + (target - start) * easeOut;
                if (originalText.includes('.')) { stat.innerText = current.toFixed(1) + suffix; } 
                else { stat.innerText = Math.floor(current) + suffix; }
                if (progress < 1) { requestAnimationFrame(update); } 
                else { stat.innerText = originalText; }
            }
            setTimeout(() => requestAnimationFrame(update), 100);
        });
    });
  </script>
</body>
</html>
