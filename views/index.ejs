<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TrackU — Focus made measurable</title>
  <meta name="description" content="Turn your daily effort into visible momentum with a planner, focus timer, analytics, streaks, and a productivity system built for consistency." />
  <meta name="keywords" content="focus tracker, productivity dashboard, study tracker, habit tracking, streaks, analytics" />
  <meta name="author" content="TrackU" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="TrackU — Focus made measurable" />
  <meta property="og:description" content="Plan your day, track your focus, and build momentum with real data." />
  <meta property="og:image" content="https://tracku.me/images/mnav.png" />
  <link rel="icon" href="/images/icon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
  <style>
    :root {
      --bg: #04080c;
      --bg-2: #09141b;
      --panel: rgba(18, 24, 31, 0.95);
      --panel-soft: rgba(27, 32, 39, 0.9);
      --stroke: rgba(148, 163, 184, 0.18);
      --text: #edf6ff;
      --muted: #9aa7b6;
      --muted-2: #738195;
      --green: #30e6b6;
      --green-2: #58f0c5;
      --green-3: #1abf98;
      --sky: #8cccff;
      --sky-2: #9ddaf7;
      --blue: #5f8cff;
      --gray: #a1b0c2;
      --shadow: rgba(0, 0, 0, 0.32);
      --shadow-strong: rgba(0, 0, 0, 0.52);
      --glow: rgba(48, 230, 182, 0.22);
      --radius: 28px;
      --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background:
        radial-gradient(circle at top left, rgba(48, 230, 182, 0.06), transparent 26%),
        radial-gradient(circle at top right, rgba(140, 204, 255, 0.07), transparent 28%),
        var(--bg);
      color: var(--text);
      font-family: var(--font);
      line-height: 1.6;
      overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }
    h1, h2, h3, h4 { letter-spacing: -0.05em; line-height: 1.05; }
    .container { width: min(1200px, calc(100% - 36px)); margin: 0 auto; }

    nav {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(16px);
      background: rgba(4, 8, 12, 0.72);
      border-bottom: 1px solid var(--stroke);
    }
    .nav-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 1.8rem;
      font-weight: 800;
      letter-spacing: -0.06em;
    }
    .brand-mark {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--green), var(--sky));
      box-shadow: 0 0 18px rgba(48, 230, 182, 0.7);
    }
    .brand span { color: var(--green); }
    .nav-actions { display: flex; align-items: center; gap: 12px; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 22px;
      border-radius: 999px;
      font-weight: 700;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      border: 1px solid transparent;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-login {
      border-color: rgba(148, 163, 184, 0.14);
      background: rgba(255,255,255,0.02);
      color: var(--text);
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--green), var(--sky));
      color: #041b18;
      box-shadow: 0 12px 30px rgba(48, 230, 182, 0.22);
    }

    .hero {
      padding: 56px 0 26px;
    }
    .hero-panel {
      display: grid;
      grid-template-columns: 1.08fr 1fr;
      align-items: center;
      gap: 40px;
    }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(48, 230, 182, 0.08);
      border: 1px solid rgba(48, 230, 182, 0.18);
      color: var(--green-2);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.76rem;
      font-weight: 700;
    }
    .hero-copy h1 {
      margin-top: 18px;
      font-size: clamp(3rem, 5vw, 5.2rem);
      font-weight: 800;
    }
    .highlight {
      display: inline-block;
      background: linear-gradient(135deg, var(--green), var(--sky));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .hero-copy p {
      margin-top: 18px;
      color: var(--muted);
      font-size: clamp(1.04rem, 1.4vw, 1.2rem);
      max-width: 620px;
    }
    .cta-row {
      margin-top: 28px;
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }
    .hero-stats {
      margin-top: 30px;
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
    }
    .stat-pill {
      min-width: 150px;
      padding: 16px 18px;
      border-radius: 18px;
      border: 1px solid var(--stroke);
      background: rgba(255,255,255,0.02);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.01);
    }
    .stat-pill strong {
      display: block;
      font-size: 1.5rem;
      color: var(--text);
      margin-bottom: 2px;
    }
    .stat-pill span {
      font-size: 0.76rem;
      color: var(--muted);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .hero-visual-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .screen-card {
      position: relative;
      width: min(600px, 100%);
      padding: 20px;
      border-radius: 30px;
      background: linear-gradient(180deg, rgba(13, 20, 26, 0.96), rgba(7, 10, 14, 0.98));
      border: 1px solid rgba(148, 163, 184, 0.18);
      box-shadow: 0 28px 70px rgba(0,0,0,0.45);
    }
    .screen-card img {
      border-radius: 22px;
      border: 1px solid rgba(148, 163, 184, 0.12);
      background: #0b1218;
    }
    .floating-pill {
      position: absolute;
      right: -18px;
      bottom: 28px;
      padding: 14px 18px;
      border-radius: 18px;
      background: rgba(12, 18, 23, 0.96);
      border: 1px solid rgba(48, 230, 182, 0.24);
      box-shadow: 0 20px 50px rgba(0,0,0,0.4);
      min-width: 180px;
    }
    .floating-pill strong {
      display: block;
      color: var(--green-2);
      font-size: 1.6rem;
      line-height: 1.1;
    }
    .floating-pill span {
      color: var(--muted);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    section { padding: 78px 0; }
    .section-head {
      margin-bottom: 26px;
    }
    .section-label {
      color: var(--green-2);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.76rem;
      font-weight: 700;
    }
    .section-head h2 {
      margin-top: 12px;
      font-size: clamp(2.2rem, 3.2vw, 3.5rem);
      font-weight: 800;
    }
    .section-head p {
      color: var(--muted);
      max-width: 760px;
      margin-top: 10px;
      font-size: 1.05rem;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    .feature-card {
      padding: 24px 22px 20px;
      border-radius: 24px;
      background: linear-gradient(180deg, rgba(15, 22, 29, 0.96), rgba(10, 14, 18, 0.98));
      border: 1px solid var(--stroke);
      box-shadow: 0 14px 30px rgba(0,0,0,0.18);
    }
    .feature-card .icon {
      width: 54px;
      height: 54px;
      display: grid;
      place-items: center;
      border-radius: 16px;
      margin-bottom: 18px;
      font-size: 1.4rem;
      color: var(--green-2);
      border: 1px solid rgba(48, 230, 182, 0.18);
      background: linear-gradient(135deg, rgba(48, 230, 182, 0.14), rgba(140, 204, 255, 0.08));
    }
    .feature-card h3 {
      font-size: 1.6rem;
      margin-bottom: 8px;
    }
    .feature-card p {
      color: var(--muted);
      margin-bottom: 18px;
    }
    .feature-card ul {
      list-style: none;
      display: grid;
      gap: 10px;
    }
    .feature-card li {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #e7eef6;
      font-size: 0.93rem;
    }
    .feature-card li::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--green), var(--sky));
      box-shadow: 0 0 12px rgba(48, 230, 182, 0.5);
    }

    .showcase-layout {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 26px;
      align-items: center;
    }
    .showcase-card {
      padding: 26px 24px;
      background: linear-gradient(180deg, rgba(11, 18, 23, 0.96), rgba(7, 11, 14, 0.98));
      border: 1px solid var(--stroke);
      border-radius: 26px;
    }
    .showcase-card h3 {
      font-size: clamp(2rem, 3vw, 2.8rem);
      margin: 12px 0 12px;
    }
    .showcase-card p {
      color: var(--muted);
      margin-bottom: 22px;
      font-size: 1.05rem;
    }
    .check-list {
      list-style: none;
      display: grid;
      gap: 12px;
    }
    .check-list li {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #e3edf7;
    }
    .check-list i {
      color: var(--green-2);
      font-size: 1.04rem;
    }
    .showcase-image {
      padding: 18px;
      border: 1px solid var(--stroke);
      border-radius: 26px;
      background: linear-gradient(180deg, rgba(12, 20, 26, 0.96), rgba(8, 13, 17, 0.98));
    }
    .showcase-image img {
      border-radius: 18px;
      border: 1px solid rgba(148, 163, 184, 0.12);
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
      margin-top: 14px;
    }
    .metric-box {
      padding: 24px 18px;
      border-radius: 18px;
      border: 1px solid var(--stroke);
      background: rgba(255,255,255,0.02);
    }
    .metric-box strong {
      display: block;
      color: var(--text);
      font-size: clamp(1.8rem, 2vw, 2.3rem);
      margin-bottom: 10px;
    }
    .metric-box span {
      color: var(--muted);
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .cta-block {
      padding: 32px 0 80px;
    }
    .cta-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
      padding: clamp(28px, 4vw, 52px);
      border-radius: 28px;
      border: 1px solid var(--stroke);
      background: linear-gradient(135deg, rgba(48, 230, 182, 0.08), rgba(140, 204, 255, 0.06), rgba(12, 17, 22, 0.98));
      box-shadow: 0 18px 40px rgba(0,0,0,0.18);
    }
    .cta-card h3 {
      font-size: clamp(2rem, 3vw, 3.1rem);
      margin-bottom: 10px;
    }
    .cta-card p {
      color: var(--muted);
      font-size: 1.04rem;
    }

    footer {
      padding: 30px 0 60px;
      border-top: 1px solid var(--stroke);
      color: var(--muted);
      text-align: center;
    }

    @media (max-width: 980px) {
      .hero-panel, .showcase-layout, .feature-grid { grid-template-columns: 1fr; }
      .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .screen-card { width: min(640px, 100%); }
    }

    @media (max-width: 640px) {
      .nav-inner { padding: 16px 18px; }
      .nav-actions .btn { padding: 10px 16px; font-size: 0.85rem; }
      .hero { padding-top: 38px; }
      .cta-row { flex-direction: column; }
      .cta-row .btn { width: 100%; }
      .hero-stats { gap: 12px; }
      .metrics-grid { grid-template-columns: 1fr; }
      .floating-pill { position: static; margin-top: 16px; }
    }

    .landing-v2 { --ink: #f5f4ef; --soft: #aaa9a4; --line: rgba(255,255,255,.12); --lime: #d4f34a; --aqua: #6de4d0; }
    .landing-v2 .container { width: min(1240px, calc(100% - 48px)); }
    .landing-v2 .landing-nav { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid var(--line); background: rgba(5,7,8,.84); backdrop-filter: blur(18px); }
    .landing-v2 .landing-nav-inner { display:flex; align-items:center; justify-content:space-between; gap:20px; min-height:76px; }
    .landing-v2 .landing-brand { display:inline-flex; align-items:center; gap:11px; color:var(--ink); font-size:1.15rem; font-weight:800; letter-spacing:-.04em; }
    .landing-v2 .landing-brand-mark { width:13px; height:13px; border-radius:50%; background:var(--lime); box-shadow:0 0 20px rgba(212,243,74,.7); }
    .landing-v2 .landing-nav-links { display:flex; align-items:center; gap:22px; color:var(--soft); font-size:.88rem; }
    .landing-v2 .landing-nav-links a:hover { color:var(--ink); }
    .landing-v2 .landing-nav-actions { display:flex; align-items:center; gap:10px; }
    .landing-v2 .landing-button { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:46px; padding:0 18px; border:1px solid var(--line); border-radius:12px; font-weight:800; transition:transform .2s ease, background .2s ease; }
    .landing-v2 .landing-button:hover { transform:translateY(-2px); }
    .landing-v2 .landing-button-quiet { color:var(--ink); background:rgba(255,255,255,.04); }
    .landing-v2 .landing-button-primary { color:#101407; background:var(--lime); border-color:var(--lime); box-shadow:0 12px 30px rgba(212,243,74,.16); }
    .landing-v2 .landing-hero { padding:clamp(64px,10vw,126px) 0 76px; border-bottom:1px solid var(--line); }
    .landing-v2 .landing-hero-grid { display:grid; grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr); align-items:center; gap:clamp(38px,6vw,92px); }
    .landing-v2 .kicker { display:inline-flex; align-items:center; gap:9px; color:var(--lime); font-size:.74rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
    .landing-v2 .kicker::before { content:''; width:28px; height:1px; background:var(--lime); }
    .landing-v2 .landing-hero h1 { max-width:650px; margin:20px 0 22px; color:var(--ink); font-size:clamp(3.4rem,7vw,7.6rem); font-weight:800; line-height:.94; letter-spacing:-.085em; }
    .landing-v2 .landing-hero h1 em { color:var(--lime); font-style:normal; }
    .landing-v2 .landing-hero-copy { max-width:560px; color:var(--soft); font-size:1.08rem; }
    .landing-v2 .landing-hero-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:30px; }
    .landing-v2 .landing-hero-note { display:flex; align-items:center; gap:9px; margin-top:18px; color:#777873; font-size:.78rem; }
    .landing-v2 .landing-hero-note i { color:var(--aqua); }
    .landing-v2 .hero-shot { position:relative; padding:12px; border:1px solid var(--line); border-radius:18px; background:#101314; box-shadow:0 34px 80px rgba(0,0,0,.42); transform:rotate(1.3deg); }
    .landing-v2 .hero-shot::after { content:'Your day, in one view'; position:absolute; right:-18px; bottom:24px; padding:11px 14px; border:1px solid rgba(212,243,74,.35); border-radius:10px; background:#161b17; color:var(--lime); font-size:.76rem; font-weight:800; transform:rotate(-1.3deg); }
    .landing-v2 .hero-shot img { width:100%; border-radius:10px; }
    .landing-v2 .landing-section { padding:clamp(76px,10vw,132px) 0; }
    .landing-v2 .section-intro { max-width:720px; margin-bottom:42px; }
    .landing-v2 .section-intro h2 { margin-top:16px; color:var(--ink); font-size:clamp(2.5rem,5vw,5.2rem); line-height:.96; }
    .landing-v2 .section-intro p { margin-top:16px; color:var(--soft); font-size:1.05rem; }
    .landing-v2 .workflow-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    .landing-v2 .workflow-card { min-height:230px; padding:26px; border:1px solid var(--line); border-radius:16px; background:linear-gradient(145deg,#141819,#0c0f10); }
    .landing-v2 .workflow-number { color:var(--lime); font-size:.78rem; font-weight:800; letter-spacing:.12em; }
    .landing-v2 .workflow-card h3 { margin:62px 0 9px; color:var(--ink); font-size:1.55rem; }
    .landing-v2 .workflow-card p { color:var(--soft); font-size:.92rem; }
    .landing-v2 .proof-section { background:#0d1111; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
    .landing-v2 .proof-grid { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); align-items:center; gap:48px; }
    .landing-v2 .proof-copy h3 { margin:16px 0; color:var(--ink); font-size:clamp(2rem,4vw,4rem); line-height:.98; }
    .landing-v2 .proof-copy p { color:var(--soft); font-size:1rem; }
    .landing-v2 .proof-list { display:grid; gap:12px; margin-top:24px; list-style:none; }
