    .landing-v2 .gallery figure:hover img { transform:scale(1.045); }
    .landing-v2 .gallery figcaption { padding:10px 12px 12px; color:#aeb0aa; font-size:.73rem; }
    .landing-v2 .mobile-strip { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; align-items:end; }
    .landing-v2 .mobile-strip figure { overflow:hidden; margin:0; border:1px solid var(--line); border-radius:16px; background:#101313; }
    .landing-v2 .mobile-strip img { width:100%; aspect-ratio: .48; object-fit:cover; }
    .landing-v2 .final-cta { padding:26px 0 104px; }
    .landing-v2 .final-cta-inner { display:flex; align-items:center; justify-content:space-between; gap:28px; padding:clamp(28px,5vw,58px); border:1px solid rgba(212,243,74,.3); border-radius:18px; background:linear-gradient(125deg,rgba(212,243,74,.1),rgba(109,228,208,.05) 55%,#111515); }
    .landing-v2 .final-cta h2 { color:var(--ink); font-size:clamp(2rem,4vw,4rem); line-height:.98; }
    .landing-v2 .final-cta p { margin-top:12px; color:var(--soft); }
    .landing-v2 .landing-footer { padding:24px 0 48px; border-top:1px solid var(--line); color:#777873; font-size:.82rem; }
    @media (max-width: 900px) { .landing-v2 .landing-hero-grid, .landing-v2 .proof-grid, .landing-v2 .mini-proof-grid { grid-template-columns:1fr; } .landing-v2 .proof-grid.reverse .proof-copy, .landing-v2 .proof-grid.reverse .proof-frame { order:initial; } .landing-v2 .gallery { grid-template-columns:repeat(3,1fr); } }
