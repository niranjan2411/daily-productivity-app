<% 
  const yearValue = currentMonth.getUTCFullYear();
  const monthValue = currentMonth.getUTCMonth();
  const monthName = currentMonth.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  const daysInMonth = new Date(Date.UTC(yearValue, monthValue + 1, 0)).getUTCDate();
  const firstDay = (new Date(Date.UTC(yearValue, monthValue, 1)).getUTCDay() + 6) % 7;
  const today = new Date();
  const todayKey = Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate());
  const accountStartDate = new Date(user.createdAt || today);
  const accountStartKey = Date.UTC(accountStartDate.getUTCFullYear(), accountStartDate.getUTCMonth(), accountStartDate.getUTCDate());
  const goalMinutes = user.dailyGoalMinutes || 300;
  const timeUnit = user.timeUnit || 'minutes';
  const getEntry = (year, month, day) => logs.find(log => { const date = new Date(log.date); return date.getUTCFullYear() === year && date.getUTCMonth() === month && date.getUTCDate() === day; });
  const getYearEntry = (year, month, day) => yearLogs.find(log => { const date = new Date(log.date); return date.getUTCFullYear() === year && date.getUTCMonth() === month && date.getUTCDate() === day; });
  const getState = (minutes, dateKey) => minutes > goalMinutes ? 'extra' : minutes > 0 ? 'focused' : dateKey >= accountStartKey && dateKey <= todayKey ? 'missed' : 'future';
  const monthValues = Array.from({ length: daysInMonth }, (_, index) => Number(getEntry(yearValue, monthValue, index + 1)?.minutes || 0));
  const monthTotal = monthValues.reduce((sum, value) => sum + value, 0);
  const monthLoggedDays = monthValues.filter(value => value > 0).length;
  const monthAvg = monthLoggedDays ? monthTotal / monthLoggedDays : 0;
  const yearValues = Array.from({ length: 12 }, (_, month) => {
    const length = new Date(Date.UTC(yearValue, month + 1, 0)).getUTCDate();
    return Array.from({ length }, (_, day) => Number(getYearEntry(yearValue, month, day + 1)?.minutes || 0));
  });
  const yearTotal = yearValues.flat().reduce((sum, value) => sum + value, 0);
  const yearLoggedDays = yearValues.flat().filter(value => value > 0).length;
  const yearAvg = yearLoggedDays ? yearTotal / yearLoggedDays : 0;
  const previousMonth = new Date(Date.UTC(yearValue, monthValue - 1, 1));
  const nextMonth = new Date(Date.UTC(yearValue, monthValue + 1, 1));
  const previousMonthString = `${previousMonth.getUTCFullYear()}-${String(previousMonth.getUTCMonth() + 1).padStart(2, '0')}`;
  const nextMonthString = `${nextMonth.getUTCFullYear()}-${String(nextMonth.getUTCMonth() + 1).padStart(2, '0')}`;
  const isFutureMonth = nextMonth.getTime() > Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), 1);
  const weekCount = Math.ceil(daysInMonth / 7);
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Goal Calendar - Focus tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/icon.svg" type="image/svg+xml">
  <style>
    :root { --calendar-purple:#7653e8; --calendar-purple-soft:#a78bfa; --calendar-panel:#111; --calendar-line:rgba(255,255,255,.13); --calendar-muted:#858b9d; }
    body { background:#050505; }
    .goal-calendar { max-width:1240px; margin:0 auto; padding:22px 54px 60px; }
    .calendar-topbar, .calendar-periodbar, .calendar-surface { border:1px solid var(--calendar-line); border-radius:20px; background:#111; }
    .calendar-topbar { display:flex; align-items:center; justify-content:space-between; gap:18px; min-height:88px; padding:16px 22px; }
    .calendar-brand { display:flex; align-items:center; gap:16px; color:var(--calendar-purple-soft); }
    .calendar-back { width:48px; height:48px; display:grid; place-items:center; border-radius:12px; background:#222; color:#fff; font-size:2rem; text-decoration:none; }
    .calendar-brand-icon { font-size:2.25rem; line-height:1; }
    .calendar-brand h1 { margin:0; font-size:1.55rem; letter-spacing:-.03em; }
    .calendar-tabs { display:flex; gap:3px; padding:4px; border:1px solid var(--calendar-line); border-radius:12px; background:#050505; }
    .calendar-tab { min-width:86px; border:0; border-radius:8px; padding:9px 14px; background:transparent; color:var(--calendar-muted); font:inherit; font-size:.85rem; font-weight:800; cursor:pointer; transition:background .22s ease,color .22s ease; }
    .calendar-tab.active { background:var(--calendar-purple); color:#fff; }
    .calendar-periodbar { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-top:16px; padding:14px 20px; }
    .calendar-period-title { display:flex; align-items:center; gap:20px; }
    .calendar-period-title h2 { margin:0; min-width:210px; color:#fff; font-size:1.25rem; }
    .calendar-arrow { width:34px; height:34px; border:0; border-radius:9px; background:#222; color:#fff; font-size:1.35rem; cursor:pointer; text-decoration:none; display:grid; place-items:center; transition:background .2s ease,transform .2s ease; }
    .calendar-arrow:hover { background:#302850; transform:translateY(-1px); }
    .calendar-actions { display:flex; align-items:center; gap:10px; }
    .calendar-add { border:0; border-radius:8px; padding:10px 15px; background:var(--calendar-purple); color:#fff; font:inherit; font-size:.85rem; font-weight:800; cursor:pointer; }
    .calendar-add:hover, .calendar-tab:hover { filter:brightness(1.12); }
    .calendar-form { margin-top:14px; padding:20px; border:1px solid var(--calendar-line); border-radius:16px; background:#111; }
    .calendar-form[hidden] { display:none; }
    .calendar-form-grid { display:grid; grid-template-columns:repeat(3, 1fr) auto; gap:14px; align-items:end; }
    .calendar-form label { display:block; margin-bottom:7px; color:var(--calendar-muted); font-size:.78rem; font-weight:700; }
    .calendar-form input, .calendar-form select { width:100%; padding:11px 12px; border:1px solid var(--calendar-line); border-radius:8px; background:#080808; color:#fff; font:inherit; }
    .calendar-form button { border:0; border-radius:8px; padding:11px 18px; background:#2dd4bf; color:#041414; font-weight:800; cursor:pointer; }
    .calendar-mode-toggle { display:flex; gap:4px; padding:4px; border:1px solid var(--calendar-line); border-radius:9px; background:#080808; }
    .calendar-mode-toggle button { flex:1; border:0; border-radius:6px; padding:8px 12px; background:transparent; color:var(--calendar-muted); font-weight:800; cursor:pointer; }
    .calendar-mode-toggle button.active { background:var(--calendar-purple); color:#fff; }
    .calendar-summary { display:flex; gap:8px; margin-top:12px; }
    .calendar-summary-item { min-width:110px; padding:8px 12px; border:1px solid var(--calendar-line); border-radius:9px; background:#191919; }
    .calendar-summary-item span { display:block; color:var(--calendar-muted); font-size:.7rem; text-transform:uppercase; letter-spacing:.06em; }
    .calendar-summary-item strong { display:block; margin-top:3px; color:var(--calendar-purple-soft); font-size:1.05rem; }
    .calendar-view { margin-top:18px; }
    .calendar-view[hidden] { display:none; }
    .month-grid { display:grid; grid-template-columns:repeat(7, minmax(0, 1fr)); overflow:hidden; border:1px solid var(--calendar-line); border-radius:16px; background:#090909; }
    .weekday { padding:16px 8px; border-right:1px solid var(--calendar-line); color:var(--calendar-muted); font-size:.75rem; font-weight:800; text-align:center; letter-spacing:.08em; }
    .month-cell { position:relative; aspect-ratio:1 / 1; min-height:0; padding:10px; border-top:1px solid var(--calendar-line); border-right:1px solid var(--calendar-line); background:#111; overflow:hidden; }
    .month-cell:nth-child(7n) { border-right:0; }
    .month-cell.empty { background:#0a0a0a; }
    .month-cell .date-number { position:relative; z-index:2; color:#aeb3c0; font-size:.82rem; font-weight:800; }
    .month-cell .focus-value { position:absolute; inset:38px 8px 8px; display:grid; place-items:center; color:#fff; font-size:1.2rem; font-weight:800; }
    .month-cell.today::before { content:'•'; position:absolute; top:5px; right:7px; z-index:3; color:#a78bfa; font-size:1.1rem; line-height:1; }
    .month-cell.focused { background:linear-gradient(145deg,rgba(255,210,30,.28),#171507); }
    .month-cell.extra { background:linear-gradient(145deg,rgba(57,211,83,.34),#0b1b10); }
    .month-cell.missed { background:#111; }
    .month-cell.missed .focus-value { color:#ff7076; font-size:4rem; font-weight:300; line-height:1; text-shadow:0 0 22px rgba(255,80,90,.45); }
    .month-cell.missed::after { content:''; position:absolute; inset:42px 18px 16px; border-radius:50%; background:rgba(255,55,65,.08); filter:blur(15px); }
    .week-grid { display:grid; grid-template-columns:repeat(5, minmax(0,1fr)); gap:18px; }
    .week-card { min-height:290px; padding:18px; border:1px solid var(--calendar-line); border-radius:14px; background:#111; }
    .week-card h3 { margin:0 0 5px; color:#fff; font-size:1.35rem; }
    .week-card .week-range { color:var(--calendar-muted); font-size:.85rem; }
    .week-card .week-total { margin-top:18px; color:var(--calendar-purple-soft); font-weight:800; }
    .week-card .week-average { margin-top:4px; color:var(--calendar-muted); font-size:.8rem; }
    .week-bars { display:flex; align-items:flex-end; gap:7px; height:145px; margin-top:16px; padding-top:10px; border-bottom:1px solid var(--calendar-line); }
    .week-day { height:100%; flex:1; display:flex; flex-direction:column; justify-content:flex-end; align-items:center; gap:7px; }
    .week-day-bar { position:relative; width:100%; min-height:0; border-radius:5px 5px 0 0; background:#ffd21e; box-shadow:0 0 15px rgba(255,210,30,.2); cursor:help; }
    .week-day-bar::after { content:attr(data-value); position:absolute; left:50%; bottom:calc(100% + 8px); z-index:5; padding:5px 7px; border:1px solid rgba(255,255,255,.15); border-radius:6px; background:#050505; color:#fff; font-size:.72rem; font-weight:700; white-space:nowrap; opacity:0; pointer-events:none; transform:translate(-50%, 4px); transition:opacity .16s ease,transform .16s ease; }
    .week-day-bar:hover::after { opacity:1; transform:translate(-50%, 0); }
    .week-day-bar.extra { background:#39d353; box-shadow:0 0 15px rgba(57,211,83,.2); }
    .week-day-label { color:var(--calendar-muted); font-size:.7rem; }
    .year-grid { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:18px; }
    .year-card { padding:14px; border:1px solid var(--calendar-line); border-radius:13px; background:#111; cursor:pointer; transition:border-color .2s ease,transform .2s ease; }
    .year-card:hover { border-color:var(--calendar-purple-soft); transform:translateY(-2px); }
    .year-card.current-month { border-color:#ffd21e; box-shadow:0 0 0 2px rgba(255,210,30,.18),0 0 20px rgba(255,210,30,.12); }
    .year-card h3 { margin:0 0 3px; color:var(--calendar-purple-soft); font-size:1.2rem; }
    .year-card-summary { margin-bottom:15px; color:var(--calendar-muted); font-size:.75rem; }
    .year-weekdays, .year-days { display:grid; grid-template-columns:repeat(7,1fr); gap:4px; }
    .year-weekdays span { color:var(--calendar-muted); font-size:.6rem; text-align:center; }
    .year-day { position:relative; aspect-ratio:1; display:grid; place-items:center; border-radius:5px; background:#202020; color:#aeb3c0; font-size:.65rem; }
    .year-day.empty { background:transparent; }
    .year-day.focused { background:#806d13; color:#fff; }
    .year-day.extra { background:#207b36; color:#fff; }
    .year-day.missed { background:rgba(255,62,72,.14); color:#ff7076; }
    .year-day.missed::after { content:'×'; position:absolute; font-size:1.1rem; }
    .year-day.missed span { opacity:.45; }
    .calendar-legend { display:flex; justify-content:flex-end; gap:18px; margin-top:14px; color:var(--calendar-muted); font-size:.75rem; }
    .legend-dot { display:inline-block; width:10px; height:10px; margin-right:5px; border-radius:50%; background:#ffd21e; }
    .legend-dot.green { background:#39d353; }
    .legend-dot.red { background:#ff626c; }
    @media (max-width:900px) { .calendar-topbar, .calendar-periodbar { align-items:flex-start; flex-direction:column; } .calendar-tabs { width:100%; } .calendar-tab { flex:1; } .calendar-periodbar { flex-wrap:wrap; } .week-grid { grid-template-columns:repeat(2, minmax(0,1fr)); } .year-grid { grid-template-columns:repeat(2, minmax(0,1fr)); } }
    @media (max-width:600px) { .goal-calendar { padding:16px 12px 50px; } .calendar-topbar, .calendar-periodbar { padding:14px; } .calendar-brand h1 { font-size:1.35rem; } .calendar-period-title { width:100%; justify-content:space-between; gap:8px; } .calendar-period-title h2 { min-width:0; font-size:1.1rem; } .calendar-actions, .calendar-summary { width:100%; } .calendar-summary-item { flex:1; min-width:0; } .calendar-form-grid, .week-grid, .year-grid { grid-template-columns:1fr; } .month-cell { padding:7px 5px; } .month-cell .focus-value { inset:28px 2px 4px; font-size:.85rem; } .month-cell.missed .focus-value { font-size:2.2rem; } .weekday { padding:9px 2px; font-size:.55rem; } }
  </style>
</head>
<body>
  <%- include('partials/loader') %>
  <%- include('partials/app-header') %>
  <main class="goal-calendar" data-user-id="<%= user.userId %>" data-year="<%= yearValue %>" data-month="<%= monthValue %>" data-month-name="<%= monthName %>" data-year-total="<%= yearTotal %>" data-year-average="<%= yearAvg %>" data-month-total="<%= monthTotal %>" data-month-average="<%= monthAvg %>">
    <header class="calendar-topbar">
      <div class="calendar-brand"><a href="/dashboard" class="calendar-back" aria-label="Back to dashboard">&lsaquo;</a><span class="calendar-brand-icon">▣</span><h1>Goal Calendar</h1></div>
      <nav class="calendar-tabs" aria-label="Calendar mode">
        <button class="calendar-tab" type="button" data-mode="week">Week</button>
        <button class="calendar-tab active" type="button" data-mode="month">Month</button>
        <button class="calendar-tab" type="button" data-mode="year">Year</button>
      </nav>
    </header>

    <section class="calendar-periodbar">
      <div class="calendar-period-title"><button class="calendar-arrow" type="button" data-period-nav="previous" aria-label="Previous period">&lsaquo;</button><h2 id="period-title"><%= monthName %></h2><button class="calendar-arrow <%= isFutureMonth ? 'disabled' : '' %>" type="button" data-period-nav="next" aria-label="Next period">&rsaquo;</button></div>
      <div class="calendar-actions"><button class="calendar-add" id="toggle-log" type="button">＋ Add focus</button></div>
    </section>

    <form class="calendar-form" id="calendar-log-form" action="/add-study-log" method="POST" hidden>
      <div class="calendar-form-grid">
        <div><label for="calendar-date">Date</label><input id="calendar-date" type="date" name="date" required></div>
        <div><label for="calendar-value"><%= timeUnit === 'hours' ? 'Hours' : 'Minutes' %></label><input id="calendar-value" type="number" name="minutes" min="0" max="<%= timeUnit === 'hours' ? '24' : '1440' %>" step="<%= timeUnit === 'hours' ? '0.1' : '1' %>" required><input type="hidden" name="timeUnit" value="<%= timeUnit %>"></div>
        <div><label>Update mode</label><div class="calendar-mode-toggle" role="group" aria-label="Focus update mode"><button type="button" class="active" data-calendar-log-mode="add">Add</button><button type="button" data-calendar-log-mode="reset">Reset</button></div><input type="hidden" id="calendar-mode" name="mode" value="add"></div>
        <button type="submit">Save</button>
      </div>
    </form>

    <div class="calendar-summary">
      <div class="calendar-summary-item"><span id="summary-total-label">Month total</span><strong id="summary-total"><%= formatMinutes(monthTotal, timeUnit) %></strong></div>
      <div class="calendar-summary-item"><span id="summary-average-label">Month average</span><strong id="summary-average"><%= formatMinutes(monthAvg, timeUnit) %></strong></div>
    </div>

    <section class="calendar-view" data-view="month">
      <div class="month-grid">
        <% ['MON','TUE','WED','THU','FRI','SAT','SUN'].forEach(day => { %><div class="weekday"><%= day %></div><% }) %>
        <% for (let blank = 0; blank < firstDay; blank++) { %><div class="month-cell empty"></div><% } %>
        <% for (let day = 1; day <= daysInMonth; day++) { const value = monthValues[day - 1]; const dateKey = Date.UTC(yearValue, monthValue, day); const state = getState(value, dateKey); const isToday = dateKey === todayKey; %><div class="month-cell <%= state %> <%= isToday ? 'today' : '' %>"><span class="date-number"><%= day %></span><span class="focus-value"><%= state === 'missed' ? '×' : value ? formatMinutes(value, timeUnit) : '' %></span></div><% } %>
      </div>
      <div class="calendar-legend"><span><i class="legend-dot red"></i>No input</span><span><i class="legend-dot"></i>Goal progress</span><span><i class="legend-dot green"></i>Above goal</span></div>
    </section>

    <section class="calendar-view" data-view="week" hidden>
      <div class="week-grid">
        <% for (let week = 0; week < weekCount; week++) { const startDay = week * 7 + 1; const endDay = Math.min(startDay + 6, daysInMonth); const values = monthValues.slice(startDay - 1, endDay); const total = values.reduce((sum, value) => sum + value, 0); const logged = values.filter(value => value > 0).length; const average = logged ? total / logged : 0; const maxBar = Math.max(...values, goalMinutes, 1); %>
          <article class="week-card" data-week-index="<%= week %>" data-week-total="<%= total %>" data-week-average="<%= average %>"><h3>Week <%= week + 1 %></h3><div class="week-range"><%= startDay %> - <%= endDay %> <%= currentMonth.toLocaleDateString('en-US', { month:'short', timeZone:'UTC' }) %></div><div class="week-bars"><% values.forEach((value, index) => { %><div class="week-day"><% if (value > 0) { %><div class="week-day-bar <%= value > goalMinutes ? 'extra' : '' %>" data-value="<%= formatMinutes(value, timeUnit) %>" title="<%= formatMinutes(value, timeUnit) %>" style="height:<%= Math.max(4, Math.round(value / maxBar * 100)) %>%"></div><% } %><span class="week-day-label"><%= startDay + index %></span></div><% }) %></div><div class="week-total">Total <%= formatMinutes(total, timeUnit) %></div><div class="week-average">Average <%= formatMinutes(average, timeUnit) %> per logged day</div></article>
        <% } %>
      </div>
    </section>

    <section class="calendar-view" data-view="year" hidden>
      <div class="year-grid">
        <% for (let month = 0; month < 12; month++) { const monthDate = new Date(Date.UTC(yearValue, month, 1)); const length = new Date(Date.UTC(yearValue, month + 1, 0)).getUTCDate(); const offset = (monthDate.getUTCDay() + 6) % 7; const values = Array.from({ length }, (_, index) => Number(getYearEntry(yearValue, month, index + 1)?.minutes || 0)); const total = values.reduce((sum, value) => sum + value, 0); const logged = values.filter(value => value > 0).length; %>
          <article class="year-card <%= yearValue === today.getUTCFullYear() && month === today.getUTCMonth() ? 'current-month' : '' %>" data-month="<%= month %>"><h3><%= monthDate.toLocaleDateString('en-US', { month:'long', timeZone:'UTC' }) %></h3><div class="year-card-summary">Click to open month view</div><div class="year-weekdays"><% ['M','T','W','T','F','S','S'].forEach(day => { %><span><%= day %></span><% }) %></div><div class="year-days"><% for (let blank = 0; blank < offset; blank++) { %><span class="year-day empty"></span><% } %><% values.forEach((value, index) => { const day = index + 1; const state = getState(value, Date.UTC(yearValue, month, day)); %><span class="year-day <%= state %>"><span><%= day %></span></span><% }) %></div></article>
        <% } %>
      </div>
    </section>
  </main>
  <script>
    let activeMode = 'month';
    let root = document.querySelector('.goal-calendar');
    const timeUnit = '<%= timeUnit %>';
    const formatValue = minutes => timeUnit === 'hours'
      ? `${(Math.round((minutes / 60) * 10) / 10).toFixed(1)}h`
      : `${Math.round(minutes)}m`;

    function bindCalendar() {
      const modeButtons = document.querySelectorAll('[data-mode]');
      const viewPanels = document.querySelectorAll('[data-view]');
      const periodTitle = document.getElementById('period-title');
      const displayedMonthName = root.dataset.monthName;
      const displayedYear = root.dataset.year;
      const titles = { month: displayedMonthName, week: `${displayedMonthName} weekly view`, year: displayedYear };
      modeButtons.forEach(button => button.addEventListener('click', () => {
        activeMode = button.dataset.mode;
        modeButtons.forEach(item => item.classList.toggle('active', item === button));
        viewPanels.forEach(panel => { panel.hidden = panel.dataset.view !== activeMode; });
        periodTitle.textContent = titles[activeMode];
        document.querySelector('.calendar-view[data-view="' + activeMode + '"]')?.animate(
          [{ opacity: .35, transform: 'translateY(4px)' }, { opacity: 1, transform: 'translateY(0)' }],
          { duration: 220, easing: 'ease-out' }
        );
        updateSummary(activeMode);
      }));
      document.getElementById('toggle-log')?.addEventListener('click', () => {
        const form = document.getElementById('calendar-log-form');
        form.hidden = !form.hidden;
      });
      document.querySelectorAll('.year-card').forEach(card => card.addEventListener('click', () => {
        navigateCalendar(`${root.dataset.year}-${String(Number(card.dataset.month) + 1).padStart(2, '0')}`, 'month');
      }));
      document.querySelectorAll('[data-period-nav]').forEach(button => button.addEventListener('click', () => {
        const current = new Date(Date.UTC(Number(root.dataset.year), Number(root.dataset.month), 1));
        if (activeMode === 'year') current.setUTCFullYear(current.getUTCFullYear() + (button.dataset.periodNav === 'next' ? 1 : -1));
        else current.setUTCMonth(current.getUTCMonth() + (button.dataset.periodNav === 'next' ? 1 : -1));
        if (current > new Date(Date.UTC(new Date().getUTCFullYear(), new Date().getUTCMonth(), 1))) return;
        navigateCalendar(`${current.getUTCFullYear()}-${String(current.getUTCMonth() + 1).padStart(2, '0')}`, activeMode);
      }));
      const dateInput = document.getElementById('calendar-date');
      if (dateInput) { dateInput.value = dateInput.value || new Date().toISOString().slice(0, 10); dateInput.max = new Date().toISOString().slice(0, 10); }
      document.querySelectorAll('[data-calendar-log-mode]').forEach(button => button.addEventListener('click', () => {
        document.querySelectorAll('[data-calendar-log-mode]').forEach(item => item.classList.toggle('active', item === button));
        document.getElementById('calendar-mode').value = button.dataset.calendarLogMode;
      }));
      bindLogForm();
    }

    function updateSummary(mode) {
      const total = mode === 'year' ? Number(root.dataset.yearTotal) : Number(root.dataset.monthTotal);
      const average = mode === 'year' ? Number(root.dataset.yearAverage) : Number(root.dataset.monthAverage);
      document.getElementById('summary-total-label').textContent = mode === 'year' ? 'Year total' : 'Month total';
      document.getElementById('summary-average-label').textContent = mode === 'year' ? 'Avg / logged day' : 'Month average';
      document.getElementById('summary-total').textContent = formatValue(total);
      document.getElementById('summary-average').textContent = formatValue(average);
    }


    async function navigateCalendar(month, mode) {
      const response = await fetch(`/calendar?month=${month}`);
      if (!response.ok) return;
      const html = await response.text();
      const nextRoot = new DOMParser().parseFromString(html, 'text/html').querySelector('.goal-calendar');
      if (!nextRoot) return;
      root.replaceWith(nextRoot);
      root = nextRoot;
      activeMode = mode;
      bindCalendar();
      document.querySelector(`[data-mode="${mode}"]`)?.click();
      window.history.pushState({}, '', `/calendar?month=${month}`);
    }

    function bindLogForm() {
      document.getElementById('calendar-log-form')?.addEventListener('submit', async event => {
        event.preventDefault();
        const form = event.currentTarget;
        const button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        button.textContent = 'Saving...';
        const response = await fetch(form.action, { method:'POST', body:new URLSearchParams(new FormData(form)), headers:{ Accept:'application/json' } });
        if (response.ok) {
          const result = await response.json();
          if (root.dataset.userId) {
            localStorage.setItem(`focus-tracker.today-sync.v1:${root.dataset.userId}`, JSON.stringify({ ...result, syncAt: Date.now() }));
          }
          if (window.focusTrackerSyncToday) {
            window.focusTrackerSyncToday(result);
          } else if (result.logDate === new Date().toISOString().slice(0, 10) && root.dataset.userId) {
            const scope = root.dataset.userId;
            const activeKey = `focus-tracker.active-session.v1:${scope}`;
            const dailyKey = `focus-tracker.daily-focus.v1:${scope}`;
            if (result.mode === 'reset') {
              const activeSession = JSON.parse(localStorage.getItem(activeKey) || 'null');
              if (activeSession) {
                activeSession.startTime = Date.now();
                localStorage.setItem(activeKey, JSON.stringify(activeSession));
              }
              localStorage.setItem(dailyKey, JSON.stringify({ date: result.logDate, seconds: 0 }));
            }
          }
          const month = `${root.dataset.year}-${String(Number(root.dataset.month) + 1).padStart(2, '0')}`;
          await navigateCalendar(month, activeMode);
        }
        button.disabled = false;
        button.textContent = 'Save';
      });
    }

    bindCalendar();
  </script>
</body>
</html>
