<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up - Focus tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/icon.svg" type="image/svg+xml">
</head>
<body>
  <%- include('partials/loader') %>
  <div class="container">
    <div class="form-box">
      <h1>Create Account</h1>
      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <form action="/signup" method="POST">
        <div class="form-group">
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div class="form-group">
          <label for="username">Username</label>
          <div style="display:flex; gap:8px;">
            <input type="text" id="username" name="username" list="username-suggestions" pattern="[a-z0-9_]{3,30}" maxlength="30" required>
            <button type="button" class="btn" id="suggest-username" style="white-space:nowrap;">Suggest</button>
          </div>
          <datalist id="username-suggestions"></datalist>
          <small id="username-status" style="display:block; margin-top:6px; color:#888;">3-30 lowercase letters, numbers, or underscores.</small>
        </div>
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" minlength="6" required>
        </div>
        <div class="form-group">
          <label for="confirmPassword">Confirm Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" minlength="6" required disabled>
          <div id="password-match-message" class="password-match-message" style="display: none;">Passwords do not match</div>
        </div>
        <button type="submit" class="btn">Sign Up</button>
      </form>
      <p class="link-text">Already have an account? <a href="/login">Login here</a></p>
    </div>
  </div>

  <script>
    const passwordInput = document.getElementById('password');
    const confirmPasswordInput = document.getElementById('confirmPassword');
    const passwordMatchMessage = document.getElementById('password-match-message');

    passwordInput.addEventListener('input', () => {
      if (passwordInput.value.length > 0) {
        confirmPasswordInput.disabled = false;
      } else {
        confirmPasswordInput.disabled = true;
      }
      validatePasswords();
    });
    confirmPasswordInput.addEventListener('input', validatePasswords);

    const nameInput = document.getElementById('name');
    const emailInput = document.getElementById('email');
    const usernameInput = document.getElementById('username');
    const suggestUsernameButton = document.getElementById('suggest-username');
    const usernameSuggestions = document.getElementById('username-suggestions');
    const usernameStatus = document.getElementById('username-status');

    async function checkUsername() {
      const params = new URLSearchParams({
        name: nameInput.value,
        email: emailInput.value,
        username: usernameInput.value
      });
      try {
        const response = await fetch(`/api/username-suggestions?${params}`);
        if (!response.ok) return;
        const result = await response.json();
        usernameStatus.textContent = usernameInput.value.length < 3
          ? 'Choose one of these suggestions or enter your own username.'
          : result.available ? 'Username is available.' : 'Username is already taken.';
        usernameStatus.style.color = usernameInput.value.length < 3
          ? '#888' : result.available ? '#4ade80' : '#fca5a5';
        usernameSuggestions.replaceChildren(...result.suggestions.map(value => {
          const option = document.createElement('option');
          option.value = value;
          return option;
        }));
      } catch (error) {
        usernameStatus.textContent = 'Username will be checked when you submit.';
        usernameStatus.style.color = '#888';
      }
    }

    suggestUsernameButton.addEventListener('click', async () => {
      usernameInput.value = '';
      await checkUsername();
      const firstSuggestion = usernameSuggestions.querySelector('option');
      if (firstSuggestion) usernameInput.value = firstSuggestion.value;
      await checkUsername();
    });
    usernameInput.addEventListener('blur', checkUsername);

    function validatePasswords() {
      if (confirmPasswordInput.value.length > 0 && passwordInput.value !== confirmPasswordInput.value) {
        passwordMatchMessage.style.display = 'block';
        passwordInput.classList.add('password-mismatch');
        confirmPasswordInput.classList.add('password-mismatch');
        passwordInput.classList.remove('password-match');
        confirmPasswordInput.classList.remove('password-match');
      } else if (confirmPasswordInput.value.length > 0 && passwordInput.value === confirmPasswordInput.value) {
        passwordMatchMessage.style.display = 'none';
        passwordInput.classList.remove('password-mismatch');
        confirmPasswordInput.classList.remove('password-mismatch');
        passwordInput.classList.add('password-match');
        confirmPasswordInput.classList.add('password-match');
      } else {
        passwordMatchMessage.style.display = 'none';
        passwordInput.classList.remove('password-mismatch', 'password-match');
        confirmPasswordInput.classList.remove('password-mismatch', 'password-match');
      }
    }
  </script>
</body>
</html>