<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - Focus tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/icon.svg" type="image/svg+xml">
  <style>
    .settings-page { max-width: 1120px; margin: 0 auto; padding: 34px 24px 80px; }
    .settings-heading { margin-bottom: 6px; font-size: 2rem; letter-spacing:-.03em; }
    .settings-subtitle { margin-bottom: 26px; color: #888; }
    .settings-overview { display:flex; align-items:center; gap:16px; margin-bottom:22px; padding:20px 24px; border:1px solid rgba(0,242,234,.18); border-radius:18px; background:linear-gradient(120deg, rgba(0,242,234,.1), rgba(20,20,20,.88) 65%, rgba(118,83,232,.1)); }
    .settings-avatar { width:58px; height:58px; display:grid; place-items:center; flex:0 0 auto; border-radius:50%; background:#00f2ea; color:#041414; font-size:1.4rem; font-weight:800; }
    .settings-overview h2 { margin:0 0 3px; font-size:1.15rem; }
    .settings-overview p { margin:0; color:#999; font-size:.85rem; }
    .settings-overview a { margin-left:auto; color:#2dd4bf; text-decoration:none; font-size:.85rem; font-weight:700; }
    .settings-alert { position:fixed; right:24px; bottom:24px; z-index:1000; display:flex; align-items:center; gap:10px; width:min(400px,calc(100vw - 32px)); margin:0; padding:14px 16px; border-radius:12px; box-shadow:0 12px 32px rgba(0,0,0,.35); animation:settings-alert-in .35s ease both; }
    .settings-success { position:fixed; overflow:hidden; border:1px solid rgba(74,222,128,.4); color:#bbf7d0; background:linear-gradient(120deg,rgba(20,100,55,.95),rgba(20,83,45,.92)); }
    .settings-success::after { content:''; position:absolute; right:0; bottom:0; left:0; height:3px; transform-origin:left; background:#4ade80; animation:settings-alert-progress 4s linear forwards; }
    .settings-success-icon { display:grid; width:24px; height:24px; place-items:center; flex:0 0 auto; border-radius:50%; background:#4ade80; color:#052e16; font-size:.85rem; font-weight:900; }
    .settings-alert.is-closing { animation:settings-alert-out .35s ease forwards; }
    .settings-error { border:1px solid rgba(239,68,68,.5); color:#fca5a5; background:rgba(127,29,29,.95); }
    .settings-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; align-items:start; }
    .settings-section { min-width:0; min-height:100%; margin-bottom:0; padding:24px; border:1px solid rgba(255,255,255,.08); border-radius:16px; background:#151515; }
    .settings-section.danger-zone { grid-column:1 / -1; border-color:rgba(239,68,68,.23); background:linear-gradient(135deg,#151515,#1a1112); }
    .settings-section-header { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:20px; }
    .settings-section h2 { margin:0 0 5px; font-size:1.15rem; }
    .settings-section-header p { margin:0; color:#888; font-size:.85rem; }
    .settings-section-badge { color:#777; font-size:.75rem; text-transform:uppercase; letter-spacing:.08em; white-space:nowrap; }
    .settings-form { max-width:560px; }
    .settings-form-group { margin-bottom:16px; }
    .settings-form-group label { display:block; margin-bottom:7px; color:#aaa; font-size:.85rem; font-weight:600; }
    .settings-form-group input { width:100%; padding:12px 13px; border:1px solid rgba(255,255,255,.13); border-radius:9px; background:#0d0d0d; color:#fff; font:inherit; }
    .settings-form-group input:focus { outline:none; border-color:#00f2ea; box-shadow:0 0 0 3px rgba(0,242,234,.1); }
    .settings-time-select { width:100%; padding:12px 13px; border:1px solid rgba(255,255,255,.13); border-radius:9px; background:#0d0d0d; color:#fff; font:inherit; }
    .settings-locked-identity { display:flex; align-items:center; justify-content:space-between; gap:14px; margin-bottom:18px; padding:12px 13px; border:1px solid rgba(255,255,255,.1); border-radius:9px; background:#0d0d0d; }
    .settings-locked-identity strong { color:#fff; }
    .settings-locked-identity span { color:#777; font-size:.78rem; }
    .settings-visibility-row { display:flex; align-items:center; justify-content:space-between; gap:18px; margin-bottom:12px; padding:14px 15px; border:1px solid rgba(255,255,255,.1); border-radius:14px; background:rgba(255,255,255,.035); }
    .settings-toggle-copy { min-width:0; }
    .settings-toggle-copy strong { display:block; margin-bottom:3px; color:#fff; font-size:.95rem; }
    .settings-toggle-copy span { display:block; color:#888; font-size:.78rem; line-height:1.45; }
    .settings-visibility-toggle { position:relative; display:block; width:58px; height:34px; flex:0 0 auto; cursor:pointer; }
    .settings-visibility-toggle input { position:absolute; width:1px; height:1px; opacity:0; }
    .settings-toggle-track { position:absolute; inset:0; border:1px solid rgba(255,255,255,.2); border-radius:999px; background:#292929; transition:background .2s ease,border-color .2s ease,box-shadow .2s ease; }
    .settings-toggle-track::after { content:''; position:absolute; top:4px; left:4px; width:24px; height:24px; border-radius:50%; background:#aaa; box-shadow:0 2px 6px rgba(0,0,0,.35); transition:transform .2s ease,background .2s ease; }
    .settings-visibility-toggle input:checked + .settings-toggle-track { border-color:rgba(45,212,191,.8); background:linear-gradient(135deg,#0f766e,#14b8a6); box-shadow:0 0 0 4px rgba(20,184,166,.1),0 0 18px rgba(20,184,166,.18); }
    .settings-visibility-toggle input:checked + .settings-toggle-track::after { transform:translateX(24px); background:#ecfeff; }
    .settings-visibility-toggle input:focus-visible + .settings-toggle-track { outline:2px solid #67e8f9; outline-offset:3px; }
    .settings-visibility-status { display:flex; align-items:center; gap:7px; margin:0 0 18px; color:#999; font-size:.8rem; }
    .settings-visibility-status strong { color:#2dd4bf; }
    .settings-visibility-status.is-private strong { color:#c4b5fd; }
    .settings-form .btn { width:auto; min-width:150px; padding:11px 19px; border:0; cursor:pointer; font-size:.9rem; }
    .settings-danger { border-color:rgba(239,68,68,.4) !important; background:transparent !important; color:#fca5a5 !important; }
    .settings-danger:hover { background:rgba(127,29,29,.2) !important; box-shadow:none !important; }
    @keyframes settings-alert-in { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
    @keyframes settings-alert-progress { from { transform:scaleX(1); } to { transform:scaleX(0); } }
    @keyframes settings-alert-out { from { opacity:1; transform:translateY(0); } to { opacity:0; transform:translateY(8px); } }
    @media (prefers-reduced-motion:reduce) { .settings-alert, .settings-success::after, .settings-alert.is-closing { animation:none; } }
    @media (max-width:700px) { .settings-page { padding:26px 15px 60px; } .settings-grid { grid-template-columns:1fr; } .settings-overview { align-items:flex-start; flex-wrap:wrap; } .settings-overview a { width:100%; margin-left:74px; } .settings-section-header { flex-direction:column; } .settings-section.danger-zone { grid-column:auto; } }
  </style>
</head>
<body>
  <%- include('partials/loader') %>
  <%- include('partials/app-header') %>

  <main class="settings-page">
    <h1 class="settings-heading">Account Settings</h1>
    <p class="settings-subtitle">Manage your public identity, goals, security, and account data.</p>

    <section class="settings-overview">
      <div class="settings-avatar"><%= (user.username || user.name || '?').charAt(0).toUpperCase() %></div>
      <div>
        <h2><%= user.name %></h2>
        <p>@<%= user.username %> &middot; <%= user.publicProfile ? 'Public profile' : 'Private profile' %></p>
      </div>
      <a href="/profile">View profile &rarr;</a>
    </section>

    <% if (success) { %><div class="settings-alert settings-success" role="status" aria-live="polite" data-settings-message data-auto-dismiss="4000"><span class="settings-success-icon" aria-hidden="true">✓</span><span><%= success %></span></div><% } %>
    <% if (error) { %><div class="settings-alert settings-error" role="alert" aria-live="assertive" data-settings-message data-auto-dismiss="4000"><span aria-hidden="true">!</span><span><%= error %></span></div><% } %>

    <div class="settings-grid">
    <section class="settings-section">
      <div class="settings-section-header"><div><h2>Public profile</h2><p>Control what other people can see and how they find you.</p></div><span class="settings-section-badge">Identity</span></div>
      <form class="settings-form" action="/update-profile" method="POST">
        <div class="settings-form-group"><label>Username</label><div class="settings-locked-identity"><strong>@<%= user.username %></strong><span>Locked after signup</span></div></div>
        <div class="settings-visibility-row">
          <div class="settings-toggle-copy"><strong>Profile visibility</strong><span>Control whether other people can discover your focus summary and leaderboard totals.</span></div>
          <label class="settings-visibility-toggle" title="Toggle profile visibility">
            <input type="hidden" name="publicProfile" value="false">
            <input type="checkbox" name="publicProfileEnabled" value="true" <%= user.publicProfile ? 'checked' : '' %> aria-label="Make profile public">
            <span class="settings-toggle-track" aria-hidden="true"></span>
          </label>
        </div>
        <p class="settings-visibility-status <%= user.publicProfile ? '' : 'is-private' %>" id="visibility-status"><span aria-hidden="true"><%= user.publicProfile ? '🌐' : '🔒' %></span> Currently <strong><%= user.publicProfile ? 'Public' : 'Private' %></strong></p>
        <button type="submit" class="btn">Save visibility</button>
      </form>
    </section>

    <section class="settings-section">
      <div class="settings-section-header"><div><h2>Daily focus goal</h2><p>Set the number of minutes you want to complete each day.</p></div><span class="settings-section-badge">Productivity</span></div>
      <form class="settings-form" action="/update-goal" method="POST">
        <div class="settings-form-group"><label for="dailyGoalMinutes">Daily goal in <%= user.timeUnit === 'hours' ? 'hours' : 'minutes' %></label><input type="number" id="dailyGoalMinutes" name="dailyGoalMinutes" value="<%= user.timeUnit === 'hours' ? Math.round((user.dailyGoalMinutes / 60) * 10) / 10 : user.dailyGoalMinutes %>" step="<%= user.timeUnit === 'hours' ? '0.1' : '1' %>" min="<%= user.timeUnit === 'hours' ? '0.1' : '1' %>" max="<%= user.timeUnit === 'hours' ? '24' : '1440' %>" required><input type="hidden" name="timeUnit" value="<%= user.timeUnit === 'hours' ? 'hours' : 'minutes' %>"></div>
        <button type="submit" class="btn">Update goal</button>
      </form>
    </section>

    <section class="settings-section">
      <div class="settings-section-header"><div><h2>Time display and input</h2><p>Choose whether focus values and time inputs use minutes or hours. Stored data remains consistent in minutes and seconds.</p></div><span class="settings-section-badge">Preference</span></div>
      <form class="settings-form" action="/update-time-preference" method="POST">
        <div class="settings-form-group"><label for="timeUnit">Time unit</label><select id="timeUnit" name="timeUnit" class="settings-time-select"><option value="minutes" <%= user.timeUnit !== 'hours' ? 'selected' : '' %>>Minutes</option><option value="hours" <%= user.timeUnit === 'hours' ? 'selected' : '' %>>Hours</option></select></div>
        <button type="submit" class="btn">Save time preference</button>
      </form>
    </section>

    <section class="settings-section">
      <div class="settings-section-header"><div><h2>Password</h2><p>Change the password used to protect your account.</p></div><span class="settings-section-badge">Security</span></div>
      <form class="settings-form" action="/update-password" method="POST">
        <div class="settings-form-group"><label for="currentPassword">Current password</label><input type="password" id="currentPassword" name="currentPassword" minlength="6" required></div>
        <div class="settings-form-group"><label for="newPassword">New password</label><input type="password" id="newPassword" name="newPassword" minlength="6" required></div>
        <div class="settings-form-group"><label for="confirmNewPassword">Confirm new password</label><input type="password" id="confirmNewPassword" name="confirmNewPassword" minlength="6" required></div>
        <button type="submit" class="btn">Update password</button>
      </form>
    </section>

    <section class="settings-section danger-zone">
      <div class="settings-section-header"><div><h2>Clear account data</h2><p>Permanently delete study logs, focus sessions, and achievements. Your account will remain active.</p></div><span class="settings-section-badge">Danger zone</span></div>
      <form class="settings-form" action="/clear-account-data" method="POST" onsubmit="return confirm('⚠️ Clear all study data, focus sessions, and achievements? This action cannot be undone.');">
        <button type="submit" class="btn settings-danger">Clear all data</button>
      </form>
    </section>
    </div>
  </main>
  <script>
    const visibilityToggle = document.querySelector('input[name="publicProfileEnabled"]');
    const visibilityStatus = document.getElementById('visibility-status');
    visibilityToggle?.addEventListener('change', () => {
      const isPublic = visibilityToggle.checked;
      visibilityStatus.classList.toggle('is-private', !isPublic);
      visibilityStatus.querySelector('span').textContent = isPublic ? '🌐' : '🔒';
      visibilityStatus.querySelector('strong').textContent = isPublic ? 'Public' : 'Private';
    });

    document.querySelectorAll('[data-auto-dismiss]').forEach((alert) => {
      window.setTimeout(() => {
        alert.classList.add('is-closing');
        alert.addEventListener('animationend', () => alert.remove(), { once: true });
        window.setTimeout(() => alert.remove(), 400);
      }, Number(alert.dataset.autoDismiss));
    });

    if (document.querySelector('[data-settings-message]')) {
      window.history.replaceState({}, document.title, window.location.pathname);
    }
  </script>
</body>
</html>
