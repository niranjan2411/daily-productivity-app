<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Focus tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/icon.svg" type="image/svg+xml">
  <style>
    .auth-page { min-height:100vh; display:grid; place-items:center; padding:28px; background:#070909; }
    .auth-shell { width:min(1060px,100%); min-height:650px; display:grid; grid-template-columns:minmax(0,1fr) minmax(390px,.82fr); overflow:hidden; border:1px solid rgba(255,255,255,.12); border-radius:24px; background:#111515; box-shadow:0 30px 90px rgba(0,0,0,.42); }
    .auth-story { position:relative; display:flex; flex-direction:column; justify-content:space-between; padding:clamp(32px,6vw,72px); background:linear-gradient(145deg,#19221f,#0d1211 72%); }
    .auth-story::after { content:''; position:absolute; width:260px; height:260px; right:-100px; bottom:-110px; border:1px solid rgba(212,243,74,.24); border-radius:50%; box-shadow:0 0 0 28px rgba(212,243,74,.04),0 0 0 56px rgba(212,243,74,.025); }
    .auth-brand { display:inline-flex; align-items:center; gap:10px; color:#f5f4ef; font-size:1.2rem; font-weight:800; letter-spacing:-.04em; }
    .auth-brand-mark { width:13px; height:13px; border-radius:50%; background:#d4f34a; box-shadow:0 0 20px rgba(212,243,74,.7); }
    .auth-story-copy { position:relative; z-index:1; max-width:440px; margin:auto 0; }
    .auth-kicker { color:#596d00; font-size:.72rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
    .auth-story h1 { margin:18px 0 18px; color:#f5f4ef; font-size:clamp(2.8rem,5vw,5rem); line-height:.94; letter-spacing:-.08em; }
    .auth-story h1 em { color:#d4f34a; font-style:normal; }
    .auth-story-copy p { color:#a9ada6; font-size:1rem; }
    .auth-points { display:grid; gap:12px; margin-top:28px; list-style:none; }
    .auth-points li { display:flex; align-items:center; gap:10px; color:#d8ddd5; font-size:.88rem; }
    .auth-points i { color:#6de4d0; }
    .auth-story-foot { position:relative; z-index:1; color:#777d75; font-size:.78rem; }
    .auth-form-panel { display:flex; align-items:center; padding:clamp(28px,5vw,64px); background:#f2f3ed; color:#171b19; }
    .auth-form-wrap { width:100%; max-width:380px; margin:auto; }
    .auth-form-wrap h2 { margin:10px 0 8px; color:#151a18; font-size:2rem; letter-spacing:-.06em; }
    .auth-form-intro { margin-bottom:28px; color:#68706a; font-size:.9rem; }
    .auth-form .form-group { margin-bottom:18px; }
    .auth-form label { display:block; margin-bottom:7px; color:#3e4741; font-size:.78rem; font-weight:800; }
    .auth-form input { width:100%; min-height:48px; padding:0 14px; border:1px solid #d2d8d0; border-radius:10px; background:#fff; color:#171b19; font:inherit; outline:none; transition:border-color .2s,box-shadow .2s; }
    .auth-form input:focus { border-color:#8fac27; box-shadow:0 0 0 3px rgba(212,243,74,.25); }
    .auth-form .btn { width:100%; min-height:50px; margin-top:6px; border:0; border-radius:10px; background:#172019; color:#e9f7a8; font:inherit; font-weight:800; cursor:pointer; }
    .auth-form .btn:hover { background:#26382a; }
    .auth-error { margin-bottom:18px; padding:11px 12px; border:1px solid #f2b9b9; border-radius:9px; background:#fff0f0; color:#a12f2f; font-size:.82rem; }
    .auth-switch { margin-top:24px; color:#68706a; font-size:.84rem; text-align:center; }
    .auth-switch a { color:#425b15; font-weight:800; }
    @media (max-width:760px) { .auth-page { padding:14px; } .auth-shell { min-height:0; grid-template-columns:1fr; } .auth-story { min-height:330px; padding:30px; } .auth-story-copy { margin:72px 0 0; } .auth-story h1 { font-size:3.2rem; } .auth-points { display:none; } .auth-story-foot { margin-top:32px; } .auth-form-panel { padding:34px 26px 40px; } }
  </style>
</head>
<body class="auth-page">
  <%- include('partials/loader') %>
  <main class="auth-shell">
    <section class="auth-story">
      <a href="/" class="auth-brand"><span class="auth-brand-mark"></span>TrackU</a>
      <div class="auth-story-copy">
        <span class="auth-kicker">Make focus visible</span>
        <h1>Pick up where your <em>best work</em> begins.</h1>
        <p>Your plans, focus sessions, and progress are ready when you are.</p>
        <ul class="auth-points"><li><i class="bi bi-check2-circle"></i> Keep today’s priorities close</li><li><i class="bi bi-check2-circle"></i> Build a rhythm you can see</li></ul>
      </div>
      <p class="auth-story-foot">A calmer system for consistent work.</p>
    </section>
    <section class="auth-form-panel">
      <div class="auth-form-wrap">
        <span class="auth-kicker">Welcome back</span>
        <h2>Sign in to TrackU</h2>
        <p class="auth-form-intro">Return to your workspace and keep your momentum moving.</p>
      <% if (error) { %>
        <div class="auth-error"><%= error %></div>
      <% } %>
      <form class="auth-form" action="/login" method="POST">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required>
        </div>
        <button type="submit" class="btn">Login</button>
      </form>
      <p class="auth-switch">New here? <a href="/signup">Create an account</a></p>
      </div>
    </section>
  </main>
</body>
</html>