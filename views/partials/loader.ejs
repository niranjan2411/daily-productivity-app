<style>
  /* 1. Glassmorphism Overlay */
  #global-loader {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(10, 10, 10, 0.7);
      backdrop-filter: blur(4px);
      z-index: 99999;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      
      /* CHANGED: Faster transition (0.15s) for snappy feel */
      transition: opacity 0.15s ease-out, visibility 0.15s;
      
      opacity: 1;
      visibility: visible;
  }

  /* 2. The Spinner - SMALLER */
  .loader-spinner {
      /* CHANGED: Smaller size (35px) */
      width: 35px;
      height: 35px;
      /* CHANGED: Thinner border (3px) */
      border: 3px solid rgba(255, 215, 0, 0.1); 
      border-top: 3px solid #FFD700;
      border-radius: 50%;
      animation: spin 0.8s linear infinite; /* Slightly faster spin */
      margin-bottom: 10px; /* Reduced gap */
      box-shadow: 0 0 10px rgba(255, 215, 0, 0.1); 
  }

  /* 3. Text Style - SMALLER */
  .loader-text {
      color: #FFD700;
      font-family: 'Segoe UI', sans-serif;
      /* CHANGED: Smaller text */
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      text-shadow: 0 2px 4px rgba(0,0,0,0.8);
      animation: pulse 1.5s infinite;
  }

  /* Utility to Hide */
  .loader-hidden {
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none;
  }

  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  @keyframes pulse { 0% { opacity: 0.7; } 50% { opacity: 1; } 100% { opacity: 0.7; } }
</style>

<div id="global-loader">
  <div class="loader-spinner"></div>
  <div class="loader-text">Loading...</div>
</div>

<script>
  // --- HIDE LOGIC (Executed Immediately) ---
  function hideLoader() {
      const loader = document.getElementById('global-loader');
      if (loader && !loader.classList.contains('loader-hidden')) {
          loader.classList.add('loader-hidden');
      }
  }

  // Run as soon as HTML is parsed (Fastest possible time)
  if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', hideLoader);
  } else {
      hideLoader();
  }
  
  // Fallback for Safari/Mobile Back Button
  window.addEventListener('pageshow', function(event) {
      if (event.persisted) hideLoader();
  });


  // --- SHOW LOGIC (Smart & Selective) ---
  
  // 1. Link Navigation
  document.addEventListener('click', function(e) {
      const link = e.target.closest('a');
      if (!link) return;

      // EXCLUSIONS:
      if (link.classList.contains('month-nav')) return; // Calendar arrows
      const href = link.getAttribute('href');
      if (!href || href.startsWith('#') || href.startsWith('javascript:')) return; // Internal links
      if (link.target === '_blank') return; // New tabs
      if (e.defaultPrevented) return; // Prevented events

      // SHOW LOADER
      const loader = document.getElementById('global-loader');
      if (loader) loader.classList.remove('loader-hidden');
  });

  // 2. Form Submission (Login/Signup Only)
  document.addEventListener('submit', function(e) {
      const form = e.target;
      const action = form.getAttribute('action');
      const loader = document.getElementById('global-loader');
      
      if (!loader) return;

      // Only show for Login and Signup
      if (action && (action.includes('login') || action.includes('signup'))) {
           if (form.checkValidity()) {
               loader.classList.remove('loader-hidden');
           }
      }
  });
</script>